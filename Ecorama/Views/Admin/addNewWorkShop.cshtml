@model Ecorama.Models.WorkshopViewModel

@{
    ViewData["Title"] = "Add New WorkShop";
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
    var today = DateTime.Today.ToString("yyyy-MM-dd");

}

<h2 class="my-4 text-center text-primary">Add New WorkShop</h2>

<div class="card shadow p-4" style="margin: 1.2rem !important">
    <form asp-action="addNewWorkShop" method="post" class="row g-3" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="col-md-6">
            <label asp-for="Title" class="form-label">Title</label>
            <input asp-for="Title" class="form-control" placeholder="Enter workshop title" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="StartDate" class="form-label">Start Date</label>
            <input asp-for="StartDate" type="date" class="form-control" min="@today"/>
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>
        
        <div class="col-md-6">
            <label asp-for="EndDate" class="form-label">End Date</label>
            <input asp-for="EndDate" type="date" class="form-control" min="@today"/>
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>


        <div class="col-12">
            <label asp-for="Organsization" class="form-label">Organization</label>
            <textarea asp-for="Organsization" class="form-control" rows="3" placeholder="Enter Organization Name"></textarea>
            <span asp-validation-for="Organsization" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter description..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="ImageFile" class="form-label">Image</label>
            <input asp-for="ImageFile" type="file" class="form-control" />
            <span asp-validation-for="ImageFile" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="WebSiteUrl" class="form-label">Website URL</label>
            <input asp-for="WebSiteUrl" class="form-control" placeholder="https://example.com" />
            <span asp-validation-for="WebSiteUrl" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Duration" class="form-label">Duration In Hours</label>
            <input asp-for="Duration" class="form-control" type="number" placeholder="Enter duration" />
            <span asp-validation-for="Duration" class="text-danger"></span>
        </div>

      @*   <div class="col-md-6">
            <label asp-for="SeatsAvailable" class="form-label">Seats Available</label>
            <input asp-for="SeatsAvailable" class="form-control" type="number" placeholder="Enter number of seats" />
            <span asp-validation-for="SeatsAvailable" class="text-danger"></span>
        </div> *@

        <div style="margin-top: 2%;" class="col-12 text-end">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Save Workshop
            </button>
            <a asp-action="seeAllWorkShop" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
