@model IEnumerable<Ecorama.Models.WorkshopRegistration>

@{
	ViewData["Title"] = "إدارة تسجيلات الورش";
	Layout = "~/Views/Shared/_Admin_Layout.cshtml";
}

<div class="container-fluid py-4">
	<div class="row">
		<div class="col-12">
			<div class="card shadow-lg border-0">
				<div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
					<h3 class="mb-0">
						<i class="fas fa-users-cog me-2"></i>
						إدارة تسجيلات الورش
					</h3>
					<div class="d-flex gap-2">
						<span class="badge bg-light text-dark fs-6">
							<i class="fas fa-chart-bar me-1"></i>
							إجمالي التسجيلات: @Model.Count()
						</span>
					</div>
				</div>
				<div class="card-body">
					@if (TempData["Success"] != null)
					{
						<div class="alert alert-success alert-dismissible fade-show">
							<i class="fas fa-check-circle me-2"></i>
							@TempData["Success"]
							<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
						</div>
					}

					@if (TempData["Error"] != null)
					{
						<div class="alert alert-danger alert-dismissible fade-show">
							<i class="fas fa-exclamation-circle me-2"></i>
							@TempData["Error"]
							<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
						</div>
					}

					<!-- شريط البحث والفلاتر -->
					<div class="row mb-4">
						<div class="col-md-6">
							<div class="input-group">
								<span class="input-group-text bg-light">
									<i class="fas fa-search"></i>
								</span>
								<input type="text" class="form-control" id="searchInput"
									   placeholder="البحث بالاسم، البريد الإلكتروني، الهاتف، أو المؤسسة...">
							</div>
						</div>
						<div class="col-md-3">
							<select class="form-select" id="workshopFilter">
								<option value="">جميع الورش</option>
								@foreach (var workshop in Model.Where(x => x.Workshop != null).GroupBy(x => x.Workshop.Title).Select(g => g.First()))
								{
									<option value="@workshop.Workshop.Title">@workshop.Workshop.Title</option>
								}
							</select>
						</div>
						<div class="col-md-3">
							<select class="form-select" id="dateFilter">
								<option value="">جميع التواريخ</option>
								<option value="today">اليوم</option>
								<option value="week">هذا الأسبوع</option>
								<option value="month">هذا الشهر</option>
							</select>
						</div>
					</div>

					@if (Model.Any())
					{
						<div class="table-responsive">
							<table class="table table-hover align-middle" id="registrationsTable">
								<thead class="table-dark">
									<tr>
										<th width="80">#</th>
										<th width="200">اسم الورشة</th>
										<th width="150">الاسم الكامل</th>
										<th width="200">البريد الإلكتروني</th>
										<th width="120">رقم الهاتف</th>
										<th width="150">المؤسسة</th>
										<th width="200">الملاحظات</th>
										<th width="130">تاريخ التسجيل</th>
										<th width="150" class="text-center">الإجراءات</th>
									</tr>
								</thead>
								<tbody id="registrationsBody">
									@foreach (var item in Model.OrderByDescending(x => x.RegisteredAt))
									{
										<tr data-id="@item.Id">
											<td>
												<span class="badge bg-secondary">#@item.Id</span>
											</td>
											<td>
												<div class="d-flex align-items-center">
													<div class="workshop-indicator bg-primary rounded-circle me-2"
														 style="width: 10px; height: 10px;"></div>
													<strong class="workshop-name">
														@(item.Workshop?.Title ?? "غير محدد")
													</strong>
												</div>
											</td>
											<td>
												<div class="user-info">
													<strong>@Html.DisplayFor(modelItem => item.FullName)</strong>
													@if (item.User != null)
													{
														<br>

														<small class="text-muted">مستخدم مسجل</small>
													}
												</div>
											</td>
											<td>
												<a href="mailto:@item.Email" class="text-decoration-none">
													<i class="fas fa-envelope me-1 text-primary"></i>
													@Html.DisplayFor(modelItem => item.Email)
												</a>
											</td>
											<td>
												<a href="tel:@item.PhoneNumber" class="text-decoration-none">
													<i class="fas fa-phone me-1 text-success"></i>
													<span class="phone-number">@Html.DisplayFor(modelItem => item.PhoneNumber)</span>
												</a>
											</td>
											<td>
												@if (!string.IsNullOrEmpty(item.Organization))
												{
													<span class="badge bg-info bg-opacity-10 text-info">
														<i class="fas fa-building me-1"></i>
														@Html.DisplayFor(modelItem => item.Organization)
													</span>
												}
												else
												{
													<span class="text-muted">غير محدد</span>
												}
											</td>
											<td>
												@if (!string.IsNullOrEmpty(item.Notes))
												{


													var shortNotes = item.Notes.Length > 50 ?
													item.Notes.Substring(0, 50) + "..." :
													item.Notes;

													<span class="notes-preview" data-bs-toggle="tooltip"
														  data-bs-placement="top" title="@item.Notes">
														<i class="fas fa-sticky-note me-1 text-warning"></i>
														@shortNotes
													</span>
												}
												else
												{
													<span class="text-muted">لا توجد ملاحظات</span>
												}
											</td>
											<td>
												<small class="text-muted">
													<i class="fas fa-calendar me-1"></i>
													@(item.RegisteredAt?.ToString("dd/MM/yyyy") ?? "غير محدد")
													<br>
													<i class="fas fa-clock me-1"></i>
													@(item.RegisteredAt?.ToString("HH:mm") ?? "")
												</small>
											</td>
											<td class="text-center">
												<div class="btn-group" role="group">
													<button type="button" class="btn btn-sm btn-outline-info"
															onclick="viewDetails(@item.Id)" title="عرض التفاصيل">
														<i class="fas fa-eye"></i>
													</button>
													<button type="button" class="btn btn-sm btn-outline-success"
															onclick="contactUser('@item.Email', '@item.PhoneNumber')" title="التواصل">
														<i class="fas fa-envelope"></i>
													</button>
													@if (Context.Session.GetString("UserEmail") == "superecorama@gmail.com")
													{
														<button type="button" class="btn btn-sm btn-outline-danger"
																onclick="deleteRegistration(@item.Id)" title="حذف">
															<i class="fas fa-trash"></i>
														</button>
													}
												</div>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>

						<!-- إحصائيات سريعة -->
						<div class="row mt-4">
							<div class="col-md-3">
								<div class="card bg-primary text-white">
									<div class="card-body text-center">
										<i class="fas fa-users fa-2x mb-2"></i>
										<h4>@Model.Count()</h4>
										<small>إجمالي التسجيلات</small>
									</div>
								</div>
							</div>
							<div class="col-md-3">
								<div class="card bg-success text-white">
									<div class="card-body text-center">
										<i class="fas fa-calendar-day fa-2x mb-2"></i>
										<h4>@Model.Count(x => x.RegisteredAt?.Date == DateTime.Today)</h4>
										<small>تسجيلات اليوم</small>
									</div>
								</div>
							</div>
							<div class="col-md-3">
								<div class="card bg-info text-white">
									<div class="card-body text-center">
										<i class="fas fa-building fa-2x mb-2"></i>
										<h4>@Model.Where(x => !string.IsNullOrEmpty(x.Organization)).GroupBy(x => x.Organization).Count()</h4>
										<small>مؤسسات مختلفة</small>
									</div>
								</div>
							</div>
							<div class="col-md-3">
								<div class="card bg-warning text-white">
									<div class="card-body text-center">
										<i class="fas fa-cogs fa-2x mb-2"></i>
										<h4>@Model.Where(x => x.Workshop != null).GroupBy(x => x.WorkshopId).Count()</h4>
										<small>ورش مختلفة</small>
									</div>
								</div>
							</div>
						</div>

						<div class="mt-3">
							<div class="alert alert-info">
								<i class="fas fa-info-circle me-2"></i>
								يمكنك استخدام أدوات البحث والفلترة أعلاه لتصفح التسجيلات بسهولة.
								انقر على أيقونة العين لعرض تفاصيل التسجيل كاملة.
							</div>
						</div>
					}
					else
					{
						<div class="text-center py-5">
							<i class="fas fa-users fa-3x text-muted mb-3"></i>
							<h5 class="text-muted">لا توجد تسجيلات حالياً</h5>
							<p class="text-muted">ستظهر هنا جميع تسجيلات الورش عند توفرها</p>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Modal لعرض تفاصيل التسجيل -->
<div class="modal fade" id="detailsModal" tabindex="-1">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header bg-primary text-white">
				<h5 class="modal-title">
					<i class="fas fa-user me-2"></i>
					تفاصيل التسجيل
				</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body" id="detailsContent">
				<!-- سيتم تحميل التفاصيل هنا -->
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		document.addEventListener('DOMContentLoaded', function() {
			// Initialize tooltips
			var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
			var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
				return new bootstrap.Tooltip(tooltipTriggerEl)
			});

			// Search functionality
			const searchInput = document.getElementById('searchInput');
			const workshopFilter = document.getElementById('workshopFilter');
			const dateFilter = document.getElementById('dateFilter');
			const tableBody = document.getElementById('registrationsBody');
			const allRows = Array.from(tableBody.querySelectorAll('tr'));

			function filterTable() {
				const searchTerm = searchInput.value.toLowerCase();
				const workshopFilterValue = workshopFilter.value.toLowerCase();
				const dateFilterValue = dateFilter.value;

				allRows.forEach(row => {
					const text = row.textContent.toLowerCase();
					const workshopName = row.querySelector('.workshop-name')?.textContent.toLowerCase() || '';

					let matchesSearch = text.includes(searchTerm);
					let matchesWorkshop = !workshopFilterValue || workshopName.includes(workshopFilterValue);
					let matchesDate = true; // يمكن تطبيق فلتر التاريخ حسب الحاجة

					if (matchesSearch && matchesWorkshop && matchesDate) {
						row.style.display = '';
					} else {
						row.style.display = 'none';
					}
				});

				updateVisibleCount();
			}

			function updateVisibleCount() {
				const visibleRows = allRows.filter(row => row.style.display !== 'none');
				// يمكن إضافة عداد للنتائج المرئية هنا
			}

			searchInput.addEventListener('input', filterTable);
			workshopFilter.addEventListener('change', filterTable);
			dateFilter.addEventListener('change', filterTable);
		});

		function viewDetails(registrationId) {
			// يمكن تنفيذ AJAX call لجلب التفاصيل
			fetch(`/Admin/WorkshopRegistrations/Details/${registrationId}`)
				.then(response => response.text())
				.then(html => {
					document.getElementById('detailsContent').innerHTML = html;
					new bootstrap.Modal(document.getElementById('detailsModal')).show();
				})
				.catch(error => {
					console.error('Error:', error);
					showToast('حدث خطأ في تحميل التفاصيل', 'error');
				});
		}

		function contactUser(email, phone) {
			const contactModal = `
				<div class="modal fade" id="contactModal" tabindex="-1">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header bg-success text-white">
								<h5 class="modal-title">
									<i class="fas fa-envelope me-2"></i>
									التواصل مع المستخدم
								</h5>
								<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
							</div>
							<div class="modal-body">
								<div class="d-grid gap-2">
									<a href="mailto:${email}" class="btn btn-outline-primary">
										<i class="fas fa-envelope me-2"></i>
										إرسال بريد إلكتروني
									</a>
									<a href="tel:${phone}" class="btn btn-outline-success">
										<i class="fas fa-phone me-2"></i>
										اتصال هاتفي
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>
			`;

			document.body.insertAdjacentHTML('beforeend', contactModal);
			new bootstrap.Modal(document.getElementById('contactModal')).show();

			// Remove modal after hiding
			document.getElementById('contactModal').addEventListener('hidden.bs.modal', function() {
				this.remove();
			});
		}

		function deleteRegistration(registrationId) {
			if (confirm('هل أنت متأكد من حذف هذا التسجيل؟')) {
				fetch(`/Admin/WorkshopRegistrations/Delete/${registrationId}`, {
					method: 'POST',
					headers: {
						'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
					}
				})
				.then(response => response.json())
				.then(data => {
					if (data.success) {
						document.querySelector(`tr[data-id="${registrationId}"]`).remove();
						showToast('تم حذف التسجيل بنجاح', 'success');
					} else {
						showToast('حدث خطأ في حذف التسجيل', 'error');
					}
				})
				.catch(error => {
					console.error('Error:', error);
					showToast('حدث خطأ في حذف التسجيل', 'error');
				});
			}
		}

		function showToast(message, type) {
			const toast = document.createElement('div');
			toast.className = `alert alert-${type === 'success' ? 'success' : 'danger'} position-fixed`;
			toast.style.cssText = 'top: 20px; left: 20px; z-index: 1060; min-width: 300px;';
			toast.innerHTML = `
				<i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>
				${message}
			`;

			document.body.appendChild(toast);

			setTimeout(() => {
				toast.remove();
			}, 3000);
		}
	</script>

	<style>
		.fade-show {
			animation: fadeIn 0.5s ease-in;
		}

		@@keyframes fadeIn {
			from

		{
			opacity: 0;
			transform: translateY(-10px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}

		}

		.btn-group .btn {
			border-radius: 0.375rem;
			margin: 0 1px;
		}

		.table th {
			border-top: none;
			font-weight: 600;
		}

		.workshop-indicator {
			flex-shrink: 0;
		}

		.user-info strong {
			color: #2c3e50;
		}

		.phone-number {
			font-family: 'Courier New', monospace;
		}

		.notes-preview {
			cursor: help;
		}

		.table tbody tr:hover {
			background-color: #f8f9fa;
		}

		.card {
			transition: transform 0.2s ease-in-out;
		}

			.card:hover {
				transform: translateY(-2px);
			}

		.input-group-text {
			border-right: none;
		}

		.form-control:focus {
			border-color: #667eea;
			box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
		}

		.form-select:focus {
			border-color: #667eea;
			box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
		}
	</style>
}

@section Style {
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
}