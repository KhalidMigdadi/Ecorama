@model List<Ecorama.Models.CourseRegistration>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "كورساتي";
}

@section Style {
    <style>
        /* Root Variables */
        :root {
            --primary-color: #063b5c;
            --secondary-color: #15a1cf;
            --light-color: #f8f9fa;
            --white: #ffffff;
            --border-radius: 15px;
            --box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
            --hover-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
            --text-primary: #212529;
            --text-secondary: #6c757d;
            --success-color: #28a745;
            --danger-color: #dc3545;
            --warning-color: #ffc107;
        }

        /* Main Container */
        .courses-container {
            padding: 6.5rem 0 3rem;
            background-color: var(--light-color);
            min-height: 100vh;
        }

        /* Page Heading */
        .courses-heading {
            color: var(--primary-color);
            font-weight: 800;
            margin-bottom: 3rem;
            position: relative;
            padding-bottom: 1.5rem;
            text-align: center;
            font-size: 2.5rem;
        }

            .courses-heading::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 50%;
                transform: translateX(-50%);
                width: 120px;
                height: 4px;
                background: var(--secondary-color);
                border-radius: 2px;
            }

        /* Navigation Buttons */
        .navigation-buttons {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2.5rem;
            gap: 1rem;
        }

        .btn-back, .btn-courses {
            padding: 0.8rem 1.8rem;
            border: none;
            border-radius: var(--border-radius);
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            position: relative;
            overflow: hidden;
        }

        .btn-back {
            background-color: var(--secondary-color);
            color: var(--white);
        }

            .btn-back:hover {
                background-color: var(--primary-color);
                color: var(--white);
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(21, 161, 207, 0.3);
            }

        .btn-courses {
            background-color: var(--primary-color);
            color: var(--white);
        }

            .btn-courses:hover {
                background-color: var(--secondary-color);
                color: var(--white);
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(6, 59, 92, 0.3);
            }

        /* Empty State */
        .no-courses {
            text-align: center;
            padding: 4rem 2rem;
            background: var(--white);
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
            margin: 2rem 0;
            border: 1px solid #e9ecef;
        }

            .no-courses h4 {
                color: var(--primary-color);
                margin-bottom: 1.5rem;
                font-weight: 700;
                font-size: 1.5rem;
            }

            .no-courses p {
                color: var(--text-secondary);
                font-size: 1.1rem;
                margin-bottom: 0;
            }

            .no-courses::before {
                content: '📚';
                font-size: 4rem;
                display: block;
                margin-bottom: 1rem;
                opacity: 0.7;
            }

        /* Course Cards */
        .course-card {
            border: none;
            border-radius: var(--border-radius);
            overflow: hidden;
            box-shadow: var(--box-shadow);
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            height: 100%;
            display: flex;
            flex-direction: column;
            background: var(--white);
            border: 1px solid #e9ecef;
            position: relative;
        }

            .course-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: var(--secondary-color);
                opacity: 0;
                transition: opacity 0.3s ease;
            }

            .course-card:hover {
                transform: translateY(-8px);
                box-shadow: var(--hover-shadow);
            }

                .course-card:hover::before {
                    opacity: 1;
                }

        /* Course Header */
        .course-header {
            background: var(--primary-color);
            color: var(--white);
            padding: 1.8rem;
            position: relative;
        }

        .course-title {
            font-weight: 700;
            margin: 0;
            font-size: 1.3rem;
            line-height: 1.4;
        }

        /* Course Body */
        .course-body {
            padding: 1.8rem;
            background: var(--white);
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        /* Course Image */
        .course-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: calc(var(--border-radius) - 5px);
            margin-bottom: 1.5rem;
            transition: transform 0.3s ease;
            border: 1px solid #e9ecef;
        }

        .course-card:hover .course-image {
            transform: scale(1.03);
        }

        /* Course Description */
        .course-description {
            color: var(--text-secondary);
            flex-grow: 1;
            margin-bottom: 1.8rem;
            line-height: 1.6;
            font-size: 0.95rem;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
        }

        /* Course Actions */
        .course-actions {
            display: flex;
            gap: 12px;
            margin-top: auto;
        }

        .btn-lessons, .btn-pdf {
            flex: 1;
            border: none;
            border-radius: calc(var(--border-radius) - 5px);
            padding: 0.8rem 1rem;
            text-align: center;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            position: relative;
            overflow: hidden;
        }

        .btn-lessons {
            background-color: var(--primary-color);
            color: var(--white);
            box-shadow: 0 4px 15px rgba(6, 59, 92, 0.2);
        }

            .btn-lessons:hover {
                background-color: var(--secondary-color);
                color: var(--white);
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(6, 59, 92, 0.3);
            }

        .btn-pdf {
            background-color: var(--danger-color);
            color: var(--white);
            box-shadow: 0 4px 15px rgba(220, 53, 69, 0.2);
        }

            .btn-pdf:hover {
                background-color: #c82333;
                color: var(--white);
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(220, 53, 69, 0.3);
            }

        /* Icons */
        .icon {
            margin-left: 8px;
            font-size: 0.9rem;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .courses-container

        {
            padding: 5rem 0 2rem;
        }

        .courses-heading {
            font-size: 2rem;
            margin-bottom: 2rem;
        }

        .navigation-buttons {
            flex-direction: column;
            gap: 15px;
            margin-bottom: 2rem;
        }

        .btn-back, .btn-courses {
            text-align: center;
            padding: 1rem;
        }

        .course-actions {
            flex-direction: column;
            gap: 10px;
        }

        .course-header {
            padding: 1.5rem;
        }

        .course-body {
            padding: 1.5rem;
        }

        .no-courses {
            padding: 3rem 1.5rem;
        }

        }

        @@media (max-width: 576px) {
            .courses-heading

        {
            font-size: 1.8rem;
        }

        .course-title {
            font-size: 1.2rem;
        }

        .course-image {
            height: 180px;
        }

        }

        /* Animation Effects */
        @@keyframes fadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .course-card {
            animation: fadeInUp 0.6s ease-out;
        }

            .course-card:nth-child(2) {
                animation-delay: 0.1s;
            }

            .course-card:nth-child(3) {
                animation-delay: 0.2s;
            }

            .course-card:nth-child(4) {
                animation-delay: 0.3s;
            }
    </style>
}

<div class="courses-container">
    <div class="container">
        <div class="navigation-buttons">
            <a href="@Url.Action("Profile", "Profile")" class="btn btn-back">
                <i class="fas fa-arrow-right icon"></i> العودة للملف الشخصي
            </a>
            <a href="@Url.Action("Index", "CoursesUser")" class="btn btn-courses">
                <i class="fas fa-book icon"></i> تصفح الكورسات
            </a>
        </div>

        <h2 class="courses-heading">كورساتي</h2>

        @if (Model.Count == 0)
        {
            <div class="no-courses">
                <h4>لا توجد كورسات مسجلة حالياً</h4>
                <p>قم بالتسجيل في كورس للبدء في التعلم</p>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var reg in Model)
                {
                    var course = reg.Course;
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="course-card">
                            <div class="course-header">
                                <h4 class="course-title">@course.Title</h4>
                            </div>
                            <div class="course-body">
                                @if (!string.IsNullOrEmpty(course.ImageUrl))
                                {
                                    <img src="@course.ImageUrl" class="course-image" alt="@course.Title" />
                                }
                                <p class="course-description">@course.Description</p>
                                <div class="course-actions">
                                    <a asp-action="Lessons" asp-route-courseId="@course.Id" class="btn btn-lessons">
                                        <i class="fas fa-play-circle icon"></i>
                                        عرض الدروس
                                    </a>
                                    @if (!string.IsNullOrEmpty(course.PdfUrl))
                                    {
                                        <a href="@course.PdfUrl" target="_blank" class="btn btn-pdf">
                                            <i class="fas fa-file-pdf icon"></i>
                                            تحميل PDF
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>