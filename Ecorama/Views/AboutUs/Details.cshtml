@model Ecorama.Models.AboutU

@{
    ViewData["Title"] = "تفاصيل المحتوى";
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";

}

<h2>@ViewData["Title"]</h2>

<div class="border p-4 rounded">
    <dl class="row">
        <dt class="col-sm-3">العنوان</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">الوصف</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">تاريخ الإضافة</dt>
        <dd class="col-sm-9">@Model.CreatedAt?.ToString("yyyy-MM-dd")</dd>
    </dl>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">تعديل</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">حذف</a>
        <a asp-action="Index" class="btn btn-secondary">رجوع</a>
    </div>
</div>
