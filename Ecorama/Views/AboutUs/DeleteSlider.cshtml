@model Ecorama.Models.AboutU

@{
    ViewData["Title"] = "حذف شريحة من نحن";
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">
                        <i class="fas fa-trash-alt me-2"></i>
                        حذف شريحة من نحن
                    </h3>
                    <a asp-action="Manage" class="btn btn-light">
                        <i class="fas fa-arrow-left me-1"></i>
                        العودة للقائمة
                    </a>
                </div>

                <div class="card-body p-4">
                    <!-- Warning Alert -->
                    <div class="alert alert-warning alert-dismissible fade-show mb-4">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>تحذير!</strong> هذا الإجراء لا يمكن التراجع عنه. سيتم حذف الشريحة والصورة المرتبطة بها نهائياً.
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>

                    <!-- Item Details for Review -->
                    <div class="row">
                        <div class="col-md-8">
                            <!-- Title Display -->
                            <div class="mb-4">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-heading me-2 text-primary"></i>
                                    عنوان الشريحة
                                </label>
                                <div class="form-control-plaintext bg-light rounded p-3 border">
                                    <strong>@Model.Title</strong>
                                </div>
                            </div>

                            <!-- Description Display -->
                            <div class="mb-4">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-align-left me-2 text-primary"></i>
                                    وصف الشريحة
                                </label>
                                <div class="form-control-plaintext bg-light rounded p-3 border" style="min-height: 120px;">
                                    @Model.Description
                                </div>
                            </div>

                            <!-- Metadata -->
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">
                                            <i class="fas fa-calendar-plus me-2 text-info"></i>
                                            تاريخ الإنشاء
                                        </label>
                                        <div class="form-control-plaintext bg-light rounded p-2 border">
                                            @Model.CreatedAt?.ToString("dd/MM/yyyy hh:mm tt")
                                        </div>
                                    </div>
                                </div>
                                @if (Model.UpdatedAt.HasValue)
                                {
                                    <div class="col-sm-6">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">
                                                <i class="fas fa-calendar-edit me-2 text-info"></i>
                                                آخر تحديث
                                            </label>
                                            <div class="form-control-plaintext bg-light rounded p-2 border">
                                                @Model.UpdatedAt?.ToString("dd/MM/yyyy hh:mm tt")
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-md-4">
                            <!-- Image Preview -->
                            <div class="mb-4">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-image me-2 text-primary"></i>
                                    صورة الشريحة
                                </label>
                                <div class="image-container">
                                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <div class="position-relative">
                                            <img src="@Model.ImageUrl" alt="@Model.Title"
                                                 class="img-fluid rounded shadow-sm preview-image"
                                                 style="width: 100%; height: 200px; object-fit: cover;" />
                                            <div class="image-overlay">
                                                <i class="fas fa-eye text-white"></i>
                                            </div>
                                            <div class="delete-overlay">
                                                <i class="fas fa-trash-alt text-white fa-2x"></i>
                                                <p class="text-white mt-2 mb-0">سيتم حذف هذه الصورة</p>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="no-image-placeholder d-flex flex-column align-items-center justify-content-center rounded bg-light border"
                                             style="height: 200px;">
                                            <i class="fas fa-image fa-3x text-muted mb-2"></i>
                                            <span class="text-muted">لا توجد صورة مرتبطة</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Confirmation Form -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="border-top pt-4">
                                <div class="text-center mb-4">
                                    <h5 class="text-danger">
                                        <i class="fas fa-question-circle me-2"></i>
                                        هل أنت متأكد من حذف هذه الشريحة؟
                                    </h5>
                                    <p class="text-muted mb-0">لن تتمكن من استرداد البيانات المحذوفة</p>
                                </div>

                                <form asp-action="DeleteConfirmed" method="post" id="deleteForm" class="d-inline">
                                    <input asp-for="Id" type="hidden" />
                                    <div class="d-flex justify-content-center gap-3">
                                        <a asp-action="Manage" class="btn btn-outline-secondary btn-lg px-4">
                                            <i class="fas fa-times me-1"></i>
                                            إلغاء
                                        </a>
                                        <button type="submit" class="btn btn-danger btn-lg px-4" id="deleteBtn">
                                            <i class="fas fa-trash-alt me-1"></i>
                                            <span class="btn-text">تأكيد الحذف</span>
                                            <span class="spinner-border spinner-border-sm ms-1 d-none" role="status"></span>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Additional Warning Card -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body bg-light">
                    <h6 class="card-title text-danger mb-3">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        معلومات مهمة قبل الحذف
                    </h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="fas fa-times text-danger me-2"></i>
                            سيتم حذف جميع بيانات الشريحة نهائياً
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-times text-danger me-2"></i>
                            سيتم حذف الصورة المرتبطة من الخادم
                        </li>
                        <li class="mb-0">
                            <i class="fas fa-times text-danger me-2"></i>
                            لا يمكن التراجع عن هذا الإجراء بعد التأكيد
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Form submission handling
            const form = document.getElementById('deleteForm');
            const deleteBtn = document.getElementById('deleteBtn');
            const spinner = deleteBtn.querySelector('.spinner-border');
            const btnText = deleteBtn.querySelector('.btn-text');

            form.addEventListener('submit', function(e) {
                e.preventDefault();

                // Show confirmation modal
                const confirmModal = document.createElement('div');
                confirmModal.className = 'modal fade';
                confirmModal.innerHTML = `
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    تأكيد نهائي للحذف
                                </h5>
                            </div>
                            <div class="modal-body text-center py-4">
                                <i class="fas fa-trash-alt fa-4x text-danger mb-3"></i>
                                <h6 class="mb-3">هل أنت متأكد 100% من حذف هذه الشريحة؟</h6>
                                <p class="text-muted mb-0">هذا الإجراء نهائي ولا يمكن التراجع عنه</p>
                            </div>
                            <div class="modal-footer justify-content-center">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                    <i class="fas fa-times me-1"></i>
                                    إلغاء
                                </button>
                                <button type="button" class="btn btn-danger" id="confirmDelete">
                                    <i class="fas fa-trash-alt me-1"></i>
                                    نعم، احذف نهائياً
                                </button>
                            </div>
                        </div>
                    </div>
                `;

                document.body.appendChild(confirmModal);
                const bsModal = new bootstrap.Modal(confirmModal);
                bsModal.show();

                // Handle final confirmation
                const confirmBtn = confirmModal.querySelector('#confirmDelete');
                confirmBtn.addEventListener('click', function() {
                    bsModal.hide();

                    // Show loading state
                    deleteBtn.disabled = true;
                    spinner.classList.remove('d-none');
                    btnText.textContent = 'جاري الحذف...';

                    // Submit the form
                    form.submit();
                });

                confirmModal.addEventListener('hidden.bs.modal', function() {
                    document.body.removeChild(confirmModal);
                });
            });

            // Image preview functionality
            const previewImage = document.querySelector('.preview-image');
            if (previewImage) {
                previewImage.addEventListener('click', function() {
                    // Create modal to view full image
                    const modal = document.createElement('div');
                    modal.className = 'modal fade';
                    modal.innerHTML = `
                        <div class="modal-dialog modal-lg modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">معاينة الصورة</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body text-center">
                                    <img src="${previewImage.src}" class="img-fluid rounded" />
                                    <div class="mt-3 p-3 bg-danger text-white rounded">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        <strong>سيتم حذف هذه الصورة نهائياً</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;

                    document.body.appendChild(modal);
                    const bsModal = new bootstrap.Modal(modal);
                    bsModal.show();

                    modal.addEventListener('hidden.bs.modal', function() {
                        document.body.removeChild(modal);
                    });
                });
            }
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

@section Style {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        .fade-show {
            animation: fadeIn 0.5s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .preview-image {
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .preview-image:hover {
                transform: scale(1.02);
                box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
            }

        .image-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
            border-radius: 0.375rem;
        }

        .delete-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(220, 53, 69, 0.8);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
            border-radius: 0.375rem;
        }

            .preview-image:hover ~ .delete-overlay,
            .delete-overlay:hover {
                opacity: 1;
            }

        .image-container:hover .image-overlay {
            opacity: 0;
        }

        .image-container:hover .delete-overlay {
            opacity: 1;
        }

        .no-image-placeholder {
            transition: all 0.3s ease;
        }

            .no-image-placeholder:hover {
                background-color: #e9ecef !important;
            }

        .form-control-plaintext {
            color: #495057 !important;
            background-color: #f8f9fa;
        }

        .btn-danger {
            background-color: #dc3545;
            border-color: #dc3545;
        }

            .btn-danger:hover {
                background-color: #c82333;
                border-color: #bd2130;
            }

        .card {
            border-radius: 1rem;
        }

        .card-header {
            border-radius: 1rem 1rem 0 0 !important;
            padding: 1.5rem;
        }

        .btn {
            border-radius: 0.5rem;
            padding: 0.5rem 1.5rem;
            font-weight: 500;
        }

        .btn-lg {
            padding: 0.75rem 2rem;
        }

        .alert {
            border-radius: 0.75rem;
            border: none;
        }

        .modal-content {
            border-radius: 1rem;
            border: none;
            box-shadow: 0 10px 40px rgba(0,0,0,0.15);
        }

        .modal-header {
            border-radius: 1rem 1rem 0 0;
            border-bottom: none;
            padding: 1.5rem;
        }

        .modal-body {
            padding: 2rem;
        }

        .modal-footer {
            border-top: none;
            padding: 1.5rem;
        }
    </style>
}