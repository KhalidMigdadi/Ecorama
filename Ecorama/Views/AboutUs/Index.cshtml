@model TeamViewModel

@{
    ViewData["Title"] = "من نحن";
}

@section Style {
    <style>
        /* Common Styles */
        :root {
            --primary-color: #2a9d8f;
            --secondary-color: #e76f51;
            --accent-color: #f4a261;
            --light-bg: #f8f9fa;
            --dark-bg: #264653;
            --text-color: #333;
            --light-text: #fff;
        }

        .section-title {
            position: relative;
            margin-bottom: 40px;
            text-align: center;
        }

            .section-title h2 {
                font-size: 2.5rem;
                font-weight: 700;
                position: relative;
                display: inline-block;
                margin-bottom: 20px;
                color: var(--primary-color);
            }

                .section-title h2::after {
                    content: '';
                    position: absolute;
                    height: 3px;
                    width: 70%;
                    background-color: var(--secondary-color);
                    bottom: -10px;
                    left: 50%;
                    transform: translateX(-50%);
                    transition: width 0.5s ease;
                }

            .section-title:hover h2::after {
                width: 100%;
            }

            .section-title p {
                color: var(--text-color);
                font-size: 1.1rem;
                max-width: 700px;
                margin: 0 auto;
            }

        /* Hero Section */
        .hero-section {
            overflow: hidden;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            margin-bottom: 60px;
        }

        .hero-image-container {
            position: relative;
            overflow: hidden;
        }

            .hero-image-container::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(rgba(38, 70, 83, 0.1), rgba(38, 70, 83, 0.7));
                z-index: 1;
            }

        .hero-caption {
            padding: 30px;
            border-radius: 15px;
            backdrop-filter: blur(5px);
            transition: all 0.5s ease;
            transform: translateY(10px);
            opacity: 0;
            animation: fadeInUp 1s forwards 0.5s;
        }

        /* Team Section */
        .team-section {
            padding: 60px 0;
            background-color: var(--light-bg);
            border-radius: 15px;
            margin-bottom: 60px;
        }

        .team-member {
            text-align: center;
            transition: transform 0.3s ease;
            padding: 20px;
        }

            .team-member:hover {
                transform: translateY(-10px);
            }

            .team-member img {
                width: 150px;
                height: 150px;
                object-fit: cover;
                border-radius: 50%;
                border: 5px solid white;
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
                transition: all 0.3s ease;
            }

            .team-member:hover img {
                border-color: var(--primary-color);
                transform: scale(1.05);
            }

            .team-member h5 {
                margin-top: 20px;
                margin-bottom: 5px;
                color: var(--primary-color);
                font-weight: 600;
            }

            .team-member p {
                color: var(--text-color);
                font-style: italic;
            }

        .team-social {
            margin-top: 15px;
        }

            .team-social a {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 35px;
                height: 35px;
                background-color: var(--light-bg);
                border-radius: 50%;
                margin: 0 5px;
                color: var(--primary-color);
                text-decoration: none;
                transition: all 0.3s ease;
            }

                .team-social a:hover {
                    background-color: var(--primary-color);
                    color: white;
                    transform: translateY(-3px);
                }

        /* Partners Section */
        .partners {
            padding: 60px 0;
            background-color: white;
            overflow: hidden;
        }

        .partners-container {
            position: relative;
            margin: 30px 0;
        }

        .partners-slider {
            display: flex;
            animation: partnerSlide 30s linear infinite;
        }

        @@keyframes partnerSlide {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(-100%);
            }
        }

        .partners-slider:hover {
            animation-play-state: paused;
        }

        .partner-item {
            min-width: 200px;
            height: 100px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0 30px;
            filter: grayscale(100%);
            transition: all 0.5s ease;
            opacity: 0.7;
        }

            .partner-item:hover {
                filter: grayscale(0);
                transform: scale(1.1);
                opacity: 1;
            }

            .partner-item img {
                max-width: 100%;
                max-height: 80px;
                object-fit: contain;
            }

        /* Why Choose Us Section */
        .why-us {
            padding: 60px 0;
            background: linear-gradient(135deg, #f6f9fc 0%, #f1f4f8 100%);
            border-radius: 15px;
        }

        .feature-item {
            padding: 30px 20px;
            border-radius: 10px;
            background-color: white;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            margin-bottom: 30px;
            text-align: right;
            transition: all 0.3s ease;
            transform: translateY(20px);
            opacity: 0;
        }

            .feature-item.animated {
                transform: translateY(0);
                opacity: 1;
            }

            .feature-item:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            }

        .feature-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background-color: rgba(42, 157, 143, 0.1);
            color: var(--primary-color);
            font-size: 1.5rem;
            margin-bottom: 20px;
            transition: all 0.3s ease;
        }

        .feature-item:hover .feature-icon {
            background-color: var(--primary-color);
            color: white;
            transform: rotateY(180deg);
        }

        .feature-title {
            margin-bottom: 15px;
            color: var(--primary-color);
            font-weight: 600;
        }

        .feature-desc {
            color: var(--text-color);
            line-height: 1.7;
        }

        /* Stats Section */
        .stats-section {
            padding: 40px 0;
            background-color: var(--dark-bg);
            color: var(--light-text);
            border-radius: 15px;
            margin: 60px 0;
        }

        .stat-item {
            text-align: center;
            padding: 20px;
        }

        .stat-count {
            font-size: 3rem;
            font-weight: 700;
            color: var(--accent-color);
            margin-bottom: 10px;
            opacity: 0;
            transform: scale(0.5);
            transition: all 1s ease;
        }

            .stat-count.counted {
                opacity: 1;
                transform: scale(1);
            }

        .stat-label {
            font-size: 1.1rem;
            color: #eee;
        }

        /* Animations */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes slideInRight {
            from {
                transform: translateX(50px);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        .fade-in {
            opacity: 0;
            animation: fadeIn 1s forwards;
        }

        .slide-in-right {
            opacity: 0;
            animation: slideInRight 0.5s forwards;
        }

        /* Custom Swiper Styles */
        .swiper-pagination-bullet {
            width: 12px;
            height: 12px;
            background-color: var(--primary-color);
            opacity: 0.5;
            transition: all 0.3s ease;
        }

        .swiper-pagination-bullet-active {
            opacity: 1;
            width: 30px;
            border-radius: 6px;
        }

        /* Responsive styles */
        @@media (max-width: 768px) {
            .section-title h2 {
                font-size: 2rem;
            }

            .stat-count {
                font-size: 2.5rem;
            }
        }
    </style>
}

<div class="container py-5">
