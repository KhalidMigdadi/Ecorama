@{
    ViewData["Title"] = "إضافة غرفة جديدة";
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
}

<div class="container mt-5 text-end" dir="rtl">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">إضافة غرفة جديدة</h3>
        </div>

        <div class="card-body">
            @if (TempData["MSG1212"] != null)
            {
                <div class="alert alert-info">@TempData["MSG1212"]</div>
            }

            <form asp-action="AddRoom" enctype="multipart/form-data" method="post">
                <div class="mb-3">
                    <label class="form-label">اسم الغرفة</label>
                    <input name="name" class="form-control" placeholder="أدخل اسم الغرفة" />
                </div>

                <div class="mb-3">
                    <label class="form-label">الوصف</label>
                    <textarea name="description" class="form-control" rows="4" placeholder="أدخل وصف الغرفة"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">السعة</label>
                    <input name="capacity" type="number" class="form-control" placeholder="أدخل عدد الأشخاص" />
                </div>

                <div class="mb-3">
                    <label class="form-label">نوع الغرفة</label>
                    <select name="type" class="form-select">
                        <option value="">-- اختر نوع الغرفة --</option>
                        <option value="اجتماعات">اجتماعات</option>
                        <option value="فردية">فردية</option>
                        <option value="جماعية">جماعية</option>
                        <option value="دراسية">دراسية</option>
                        <option value="ورشة عمل">ورشة عمل</option>
                    </select>
                </div>


                <div class="mb-3">
                    <label class="form-label">صورة الغرفة</label>
                    <input type="file" name="imageFile" class="form-control" />
                </div>

                <div class="d-flex justify-content-between">
                    <input type="submit" value="إضافة الغرفة" class="btn btn-success px-4" />
                    <a asp-action="Index" class="btn btn-secondary">رجوع للقائمة</a>
                </div>
            </form>
        </div>
    </div>
</div>
