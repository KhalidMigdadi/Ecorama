@model List<RoomAvailability>
@{
	ViewData["Title"] = "توافر الغرفة";
	Layout = "~/Views/Shared/_Admin_Layout.cshtml";
	string roomName = ViewBag.RoomName;
	int roomId = ViewBag.RoomId;
}

<div class="container mt-5 text-end" dir="rtl">
	<h2 class="mb-4">جميع التوافرات لغرفة: <span class="text-primary">@roomName</span></h2>

	<a asp-action="AddAvailability" asp-route-roomId="@roomId" class="btn btn-success mb-3">➕ إضافة توافر جديد</a>
	<a asp-action="Index" class="btn btn-secondary mb-3">رجوع إلى قائمة الغرف</a>

	@if (Model.Count == 0)
	{
		<div class="alert alert-info">لا يوجد توافر مسجل لهذه الغرفة.</div>
	}
	else
	{
		<table class="table table-bordered table-hover">
			<thead class="table-dark">
				<tr>
					<th>من التاريخ</th>
					<th>إلى التاريخ</th>
					<th>من الساعة</th>
					<th>إلى الساعة</th>
					@if (Context.Session.GetString("UserEmail") == "superecorama@gmail.com")
					{

						<th>الإجراءات</th>
					}
				</tr>
			</thead>
			<tbody>
				@foreach (var item in Model)
				{
					<tr>
						<td>@item.AvailableFromDate</td>
						<td>@item.AvailableToDate</td>
						<td>@item.AvailableFromTime</td>
						<td>@item.AvailableToTime</td>
						@if (Context.Session.GetString("UserEmail") == "superecorama@gmail.com")
						{
							<td>
								<a asp-action="DeleteAvailability" asp-route-id="@item.AvailabilityId" asp-route-roomId="@roomId"
								   class="btn btn-danger btn-sm"
								   onclick="return confirm('هل أنت متأكد من حذف هذا التوافر؟');">
									حذف
								</a>
							</td>
						}
					</tr>
				}
			</tbody>
		</table>
	}
</div>
