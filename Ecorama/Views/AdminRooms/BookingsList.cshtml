@model List<RoomBooking>
@{
    ViewData["Title"] = "إدارة الحجوزات";
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
}

<div class="container mt-5 text-end" dir="rtl">
    <h2 class="mb-4">قائمة الحجوزات</h2>

    <table class="table table-bordered table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>الغرفة</th>
                <th>المستخدم</th>
                <th>التاريخ</th>
                <th>من الساعة</th>
                <th>إلى الساعة</th>
                <th>عدد الضيوف</th>
                <th>الحالة</th>
                <th>الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.Room?.Name</td>
                    <td>@b.User?.FirstName @b.User?.LastName</td>
                    <td>@b.BookingDate</td>
                    <td>@b.BookingFrom</td>
                    <td>@b.BookingTo</td>
                    <td>@b.NumberOfGuests</td>
                    <td>
                        @if (b.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">قيد المراجعة</span>
                        }
                        else if (b.Status == "Approved")
                        {
                            <span class="badge bg-success">مقبول</span>
                        }
                        else if (b.Status == "Rejected")
                        {
                            <span class="badge bg-danger">مرفوض</span>
                        }
                    </td>
                    <td>
                        @if (b.Status == "Pending")
                        {
                            <a asp-action="ApproveBooking" asp-route-id="@b.BookingId" class="btn btn-success btn-sm">قبول</a>
                            <a asp-action="RejectBooking" asp-route-id="@b.BookingId" class="btn btn-danger btn-sm">رفض</a>
                        }
                        else
                        {
                            <span class="text-muted">--</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
