@model Room
@{
    ViewData["Title"] = "تعديل بيانات الغرفة";
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
}

<div class="container mt-5 text-end" dir="rtl">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">تعديل بيانات الغرفة</h3>
        </div>

        <div class="card-body">
            @if (TempData["MSG"] != null)
            {
                <div class="alert alert-info">@TempData["MSG"]</div>
            }

            <form asp-action="EditRoom" method="post" enctype="multipart/form-data">
                <input type="hidden" name="id" value="@Model.RoomId" />

                <div class="mb-3">
                    <label class="form-label">اسم الغرفة</label>
                    <input name="name" value="@Model.Name" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">الوصف</label>
                    <textarea name="description" class="form-control" rows="4">@Model.Description</textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">السعة</label>
                    <input name="capacity" type="number" value="@Model.Capacity" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Type" class="form-label">نوع الغرفة</label>
                    <select asp-for="Type" asp-items="ViewBag.RoomTypes" class="form-select">
                        <option value="">-- اختر نوع الغرفة --</option>
                    </select>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>



                <div class="mb-3">
                    <label class="form-label">الصورة الحالية</label><br />
                    <img src="@Model.ImageUrl" width="150" class="rounded shadow-sm border" />
                </div>

                <div class="mb-3">
                    <label class="form-label">تحديث صورة الغرفة (اختياري)</label>
                    <input type="file" name="imageFile" class="form-control" />
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary">تحديث</button>
                    <a asp-action="Index" class="btn btn-secondary">رجوع للقائمة</a>
                </div>
            </form>
        </div>
    </div>
</div>
