@model List<Room>
@{
    ViewData["Title"] = "إدارة الغرف";
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">
                        <i class="fas fa-door-open me-2"></i>
                        إدارة الغرف
                    </h3>
                    <div class="d-flex gap-2">
                        <a asp-action="AddRoom" class="btn btn-light">
                            <i class="fas fa-plus me-1"></i>
                            إضافة غرفة جديدة
                        </a>
                        <a asp-action="ExportRoomsToExcel" class="btn btn-success">
                            <i class="fas fa-file-excel me-1"></i>
                            تصدير إلى Excel
                        </a>

                    </div>
                </div>
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade-show">
                            <i class="fas fa-check-circle me-2"></i>
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle" id="roomsTable">
                                <thead class="table-dark">
                                    <tr>
                                        <th width="60">الصورة</th>
                                        <th>اسم الغرفة</th>
                                        <th>السعة</th>
                                        <th>النوع</th>
                                        <th width="100">الحالة</th>
                                        <th width="120">تاريخ الإضافة</th>
                                        <th width="200" class="text-center">الإجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                {
                                                    <img src="@item.ImageUrl" alt="@item.Name"
                                                         class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-light d-flex align-items-center justify-content-center"
                                                         style="width: 50px; height: 50px; border-radius: 0.375rem;">
                                                        <i class="fas fa-door-open text-muted"></i>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@item.Capacity شخص</span>
                                            </td>
                                            <td>
                                                <span class="text-muted">@item.Type</span>
                                            </td>
                                            <td>
                                                <span class="badge @(item.IsActive == true ? "bg-success" : "bg-danger")">
                                                    @(item.IsActive == true ? "مفعّلة" : "معطّلة")
                                                </span>
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    @item.CreatedAt?.ToString("yyyy-MM-dd")
                                                </small>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group-vertical" role="group">
                                                    <div class="btn-group mb-1" role="group">
                                                        <a asp-action="EditRoom" asp-route-id="@item.RoomId"
                                                           class="btn btn-sm btn-outline-warning" title="تعديل">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                        <a asp-action="ToggleStatus" asp-route-id="@item.RoomId"
                                                           class="btn btn-sm btn-outline-@(item.IsActive == true ? "secondary" : "success")"
                                                           title="@(item.IsActive == true ? "تعطيل" : "تفعيل")">
                                                            <i class="fas fa-@(item.IsActive == true ? "pause" : "play")"></i>
                                                        </a>
                                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                                onclick="confirmDelete(@item.RoomId)" title="حذف">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                    <div class="btn-group" role="group">
                                                        <a asp-action="AddAvailability" asp-route-roomId="@item.RoomId"
                                                           class="btn btn-sm btn-success" title="إضافة توافر">
                                                            <i class="fas fa-calendar-plus me-1"></i>
                                                            اضافة وقت للغرفه
                                                        </a>
                                                        <a asp-action="ViewAvailability" asp-route-roomId="@item.RoomId"
                                                           class="btn btn-sm btn-info" title="عرض التوافر">
                                                            <i class="fas fa-eye me-1"></i>
                                                            عرض أوقات
                                                        </a>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-3">
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i>
                                إجمالي الغرف: <strong>@Model.Count()</strong>
                                <span class="ms-3">
                                    المفعّلة: <strong class="text-success">@Model.Count(r => r.IsActive == true)</strong>
                                </span>
                                <span class="ms-3">
                                    المعطّلة: <strong class="text-danger">@Model.Count(r => r.IsActive != true)</strong>
                                </span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-door-open fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">لا توجد غرف متاحة حالياً</h5>
                            <p class="text-muted">ابدأ بإضافة غرفة جديدة</p>
                            <a asp-action="AddRoom" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i>
                                إضافة أول غرفة
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize search functionality
            if (document.getElementById('roomsTable')) {
                const searchInput = document.createElement('input');
                searchInput.type = 'text';
                searchInput.placeholder = 'البحث عن اسم الغرفة...';
                searchInput.className = 'form-control mb-3';
                searchInput.style.maxWidth = '300px';

                const tableContainer = document.querySelector('.table-responsive');
                tableContainer.parentNode.insertBefore(searchInput, tableContainer);

                searchInput.addEventListener('input', function() {
                    const searchTerm = this.value.toLowerCase();
                    const rows = document.querySelectorAll('#roomsTable tbody tr');

                    rows.forEach(row => {
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(searchTerm) ? '' : 'none';
                    });
                });
            }
        });

        function confirmDelete(id) {
            Swal.fire({
                title: 'هل أنت متأكد؟',
                text: "سيتم حذف الغرفة بشكل نهائي!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'نعم، احذفها',
                cancelButtonText: 'إلغاء',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    showToast('جاري حذف الغرفة...', 'info');
                    window.location.href = '/AdminRooms/Delete/' + id;
                }
            });
        }

        function showToast(message, type) {
            const toast = document.createElement('div');
            toast.className = `alert alert-${type === 'success' ? 'success' : type === 'info' ? 'info' : 'danger'} position-fixed`;
            toast.style.cssText = 'top: 20px; right: 20px; z-index: 1060; min-width: 300px;';
            toast.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'info' ? 'info-circle' : 'exclamation-circle'} me-2"></i>
                ${message}
            `;

            document.body.appendChild(toast);

            setTimeout(() => {
                toast.remove();
            }, 3000);
        }
    </script>

    <style>
        #roomsTable tr:hover {
            background-color: #f8f9fa;
        }

        .btn-group .btn, .btn-group-vertical .btn {
            border-radius: 0.375rem;
            margin: 0 1px;
        }

        .btn-group-vertical .btn-group {
            width: 100%;
        }

            .btn-group-vertical .btn-group .btn {
                flex: 1;
            }

        .table th {
            border-top: none;
            font-weight: 600;
        }

        .fade-show {
            animation: fadeIn 0.5s ease-in;
        }

        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .badge {
            font-size: 0.75em;
        }

        .img-thumbnail {
            border: 1px solid #dee2e6;
        }

        .text-muted {
            font-size: 0.9em;
        }

        .card-header .btn {
            transition: all 0.3s ease;
        }

            .card-header .btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            }

        .btn-group-vertical {
            min-width: 140px;
        }

        /* Custom styling for room capacity badge */
        .badge.bg-info {
            color: #fff;
            background-color: #0dcaf0 !important;
        }

        /* Enhanced hover effects */
       /*  .table tbody tr:hover {
            background-color: #f8f9fa;
            transform: scale(1.01);
            transition: all 0.2s ease;
        } */

        /* Responsive button groups */
        @@media (max-width: 768px) {
            .btn-group-vertical

        {
            min-width: 100px;
        }

        .btn-group-vertical .btn {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
        }

        }
    </style>
}

@section Style {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
}