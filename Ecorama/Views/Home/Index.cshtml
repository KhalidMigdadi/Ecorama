<div class="slider-container">
	@* Dynamic slider images *@
	@{
		int index = 0;
	}
	@foreach (var slide in Model.Sliders)
	{
		<div class="slider-image @(index == 0 ? "active" : "")" style="background-image: url('@Url.Content(slide.ImageUrl)')">
			<div class="overlay">
				@* <h2 style="color: #fff;">@slide.Title</h2>   <br /> *@
				<p class="text">@slide.Description</p>
			</div>
		</div>
		index++;
	}
</div>


