		/* Slider */
		.slider-container {
			position: relative;
			width: 100%;
			height: calc(100vh - 55px);
			overflow: hidden;
			display: flex;
			justify-content: center;
			align-items: center;
		}

		.slider-image {
			width: 100%;
			height: 100%;
			position: absolute;
			background-size: cover;
			background-position: center;
			opacity: 0;
			transition: opacity 1s ease-in-out;
		}

			.slider-image.active {
				opacity: 1;
			}

		.overlay {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background-color: rgba(0, 0, 0, 0.6);
			display: flex;
			align-items: center;
			justify-content: center;
		}

			.overlay .text {
				color: white;
				font-size: 2rem;
				text-align: center;
			}

			.overlay .text {
				color: white;
				font-size: 2rem;
				text-align: center;
				padding: 10px;
				font-weight: bold;
				text-shadow: 2px 2px 8px rgba(0,0,0,0.6); /* Added text shadow for better visibility */
				animation: fadeIn 2s ease-in-out;
			}

		/* Animation for text */
		@@keyframes fadeIn {
			0% {
				opacity: 0;
				transform: translateY(-20px);
			}

			100% {
				opacity: 1;
				transform: translateY(0);
			}
		}


		.overlay h2 {
			font-size: 2rem;
			margin-bottom: 10px; /* المسافة بين h2 و p */
		}

		.overlay p {
			font-size: 1.2rem;
			text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.6); /* تأثير الظل للنص */
		}



		/* End Slider */


		.partners {
			padding: 60px 0;
			background-color: white;
			overflow: hidden;
		}

		.partners-container {
			position: relative;
			margin: 30px 0;
		}

		.partners-slider {
			display: flex;
			animation: partnerSlide 60s linear infinite;
		}

		@@keyframes partnerSlide {
			0% {
				transform: translateX(0);
			}

			100% {
				transform: translateX(-50%);
			}
		}


		.partners-slider:hover {
			animation-play-state: paused;
		}

		.partner-item {
			min-width: 200px;
			height: 100px;
			display: flex;
			justify-content: center;
			align-items: center;
			margin: 0 30px;
			filter: grayscale(100%);
			transition: all 0.5s ease;
			opacity: 0.7;
		}

			.partner-item:hover {
				filter: grayscale(0);
				transform: scale(1.1);
				opacity: 1;
			}

			.partner-item img {
				max-width: 100%;
				max-height: 80px;
				object-fit: contain;
			}


		/* Partners */
		.partners-slider-section {
			padding: 60px 0;
			background: white;
			overflow: hidden;
		}

		.slider-containerP {
			position: relative;
			width: 100%;
			margin: 40px auto;
			overflow: hidden;
		}

		.slider-track {
			display: flex;
			width: max-content;
			animation: scroll 20s linear infinite;
			will-change: transform;
		}

		.slider-containerP:hover .slider-track {
			animation-play-state: paused;
		}

		.slider-item {
			width: 200px;
			height: 100px;
			margin: 0 25px;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
		}

			.slider-item img {
				max-width: 100%;
				max-height: 70px;
				filter: grayscale(100%);
				opacity: 1;
				transition: all 0.3s ease;
			}

			.slider-item:hover img {
				filter: grayscale(0);
				opacity: 1;
				transform: scale(1.1);
			}

		@@keyframes scroll {
			0% {
				transform: translateX(0);
			}

			100% {
				transform: translateX(-50%);
			}
			/* تحريك بنسبة 50% فقط */
		}

		@@media (max-width: 768px) {
			.slider-item {
				width: 150px;
				margin: 0 15px;
			}
		}

		.partners-slider {
			display: flex;
			/* animation يتم إضافتها عبر JS */
		}

			@@keyframes partnerSlide {
			0%

		{
			transform: translateX(0);
		}

		100% {
			transform: translateX(-50%);
		}

		}

		.partners-slider.animate {
			animation: partnerSlide 60s linear infinite;
		}

		.partners-slider:hover {
			animation-play-state: paused;
		}


	</style>
}

