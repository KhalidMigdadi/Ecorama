<!-- Courses Section -->
<section id="edu-courses-section" class="edu-courses-style">
	<div class="edu-container">
		<div class="edu-header">
			<h2>كورساتنا التعليمية</h2>
			<div class="edu-decoration"></div>
		</div>

		<div class="swiper eduCoursesSwiper edu-swiper">
			<div class="swiper-wrapper">
				@foreach (var course in Model.Courses)
				{
					int lessonCount = 0;
					if (courseLessonsCounts != null && courseLessonsCounts.ContainsKey(course.Id))
					{
						lessonCount = courseLessonsCounts[course.Id];
					}
					<div class="swiper-slide edu-slide">
						<div class="edu-img-wrapper" style="position: relative;">
							<img src="@course.ImageUrl" alt="@course.Title" />
							<div class="edu-date-badge">@course.Date?.ToString("dd MMMM yyyy")</div>
						</div>
						<div class="edu-content-box">
							<h3>@course.Title</h3>
							<div class="edu-meta-info">

								
								<div class="edu-meta-item">
									<i class="fa-solid fa-hashtag"></i> @lessonCount درس
								</div>

							</div>
							<p>@course.Description</p>
							<div class="edu-bottom-bar">
								@if (registeredCourseIds.Contains(course.Id))
								{
									<a asp-controller="CoursesUser" asp-action="Lessons" asp-route-courseId="@course.Id" class="btn btn-lessons">
										<i class="fas fa-play-circle icon"></i>
										عرض الدروس
									</a>
									@if (!string.IsNullOrEmpty(course.PdfUrl))
									{
										<a href="@course.PdfUrl" target="_blank" class="btn btn-pdf">
											<i class="fas fa-file-pdf icon"></i>
											تحميل PDF
										</a>
									}
								}
								else
								{
									<a asp-action="Register" asp-route-courseId="@course.Id" class="enroll-btn">اشترك الآن</a>
								}

							</div>
						</div>
					</div>
				}
			</div>

			<div class="swiper-button-next edu-nav-next"></div>
			<div class="swiper-button-prev edu-nav-prev"></div>
			<div class="swiper-pagination"></div>
		</div>

		<div class="edu-more-link">
			<a href="@Url.Action("Index", "CoursesUser")"><i class="fas fa-chevron-left"></i> عرض جميع الكورسات</a>
		</div>
	</div>
</section>


<!-- News Ticker -->
<section class="news-ticker">
	<div class="ticker-title">آخر الأخبار</div>

	<div class="ticker-wrapper">
		<div class="ticker-news">
			@if (ViewBag.LatestNewsTicker != null)
			{
				foreach (var news in ViewBag.LatestNewsTicker)
				{
					<div class="ticker-item">
						<i class="fas fa-bullhorn"></i>
						<a href="@Url.Action("NewsDetails", "News", new { id = news.Id })" style="color: #fff" class="ticker-link">
							@news.Title
						</a>
					</div>
				}
			}
		</div>
	</div>
</section>



<section class="news-section">
	<div class="containerN">
		<div class="section-title">
			<h2>آخر الأخبار والمقالات</h2>
			<div class="title-decoration"></div>
		</div>

		<div class="news-timeline">
			<div class="timeline-line"></div>

			@foreach (var news in Model.LatestNews)
			{
				<div class="news-item">
					<div class="news-date-badge">

						@if (news.CreatedAt.HasValue)
						{
							<div class="day">@news.CreatedAt.Value.Day.ToString("00")</div>
							<div class="month">@news.CreatedAt.Value.ToString("MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</div>
						}
						else
						{
							<div class="day">--</div>
							<div class="month">--</div>
						}


					</div>


					<div class="news-content-wrapper">
						<div class="news-content-flex">
							<div class="news-image-container">
								<img src="~/img/news/@news.ImageUrl" alt="@news.Title" />
								<div class="news-category"> <!-- ممكن تضيف تصنيف إذا عندك --> </div>
							</div>
							<div class="news-text-content">
								<h3 class="news-title">@news.Title</h3>
								<p class="news-excerpt">
									@(
																news.Content.Length > 150 ? news.Content.Substring(0, 150) + "..." : news.Content
																)
								</p>
								<a href="@Url.Action("NewsDetails", "News", new { id = news.Id })" class="read-more">اقرأ المزيد &larr;</a>

							</div>
						</div>
					</div>
				</div>
			}
		</div>

		<div class="view-all-btn">
			<a href="@Url.Action("News","News")">عرض جميع الأخبار</a>
		</div>
	</div>
</section>




