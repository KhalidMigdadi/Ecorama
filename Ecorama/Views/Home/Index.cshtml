			background-color: white;
			overflow: hidden;
		}

		.partners-container {
			position: relative;
			margin: 30px 0;
		}

		.partners-slider {
			display: flex;
			animation: partnerSlide 60s linear infinite;
		}

		@@keyframes partnerSlide {
			0% {
				transform: translateX(0);
			}

			100% {
				transform: translateX(-50%);
			}
		}


		.partners-slider:hover {
			animation-play-state: paused;
		}

		.partner-item {
			min-width: 200px;
			height: 100px;
			display: flex;
			justify-content: center;
			align-items: center;
			margin: 0 30px;
			filter: grayscale(100%);
			transition: all 0.5s ease;
			opacity: 0.7;
		}

			.partner-item:hover {
				filter: grayscale(0);
				transform: scale(1.1);
				opacity: 1;
			}

			.partner-item img {
				max-width: 100%;
				max-height: 80px;
				object-fit: contain;
			}


		/* Partners */
		.partners-slider-section {
			padding: 60px 0;
			background: white;
			overflow: hidden;
		}

		.slider-containerP {
			position: relative;
			width: 100%;
			margin: 40px auto;
			overflow: hidden;
		}

		.slider-track {
			display: flex;
			width: max-content;
			animation: scroll 20s linear infinite;
			will-change: transform;
		}

		.slider-containerP:hover .slider-track {
			animation-play-state: paused;
		}

		.slider-item {
			width: 200px;
			height: 100px;
			margin: 0 25px;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
		}

			.slider-item img {
				max-width: 100%;
				max-height: 70px;
				filter: grayscale(100%);
				opacity: 1;
				transition: all 0.3s ease;
			}

			.slider-item:hover img {
				filter: grayscale(0);
				opacity: 1;
				transform: scale(1.1);
			}

		@@keyframes scroll {
			0% {
				transform: translateX(0);
			}

			100% {
				transform: translateX(-50%);
			}
			/* تحريك بنسبة 50% فقط */
		}

		@@media (max-width: 768px) {
			.slider-item {
				width: 150px;
				margin: 0 15px;
			}
		}

		.partners-slider {
			display: flex;
			/* animation يتم إضافتها عبر JS */
		}

			@@keyframes partnerSlide {
			0%

		{
			transform: translateX(0);
		}

		100% {
			transform: translateX(-50%);
		}

		}

