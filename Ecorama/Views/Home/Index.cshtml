@model Ecorama.Models.HomeViewModel




@{
	ViewData["Title"] = "Home";
	Layout = "~/Views/Shared/_Layout.cshtml"; // أو أي Layout عام بتستخدمه
}



@section Style {

	

	<link rel="stylesheet" href="/css/course/css/bootstrap.min.css">
	<link rel="stylesheet" href="/css/course/css/font-awesome.min.css">
	<link rel="stylesheet" href="/css/course/css/owl.carousel.css">
	<link rel="stylesheet" href="/css/course/css/style.css">

	<!-- MAIN CSS -->
	<link rel="stylesheet" href="~/css/course/css/templatemo-style.css">

	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css" />


	<!-- Swiper CSS -->
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />
	<!-- Font Awesome for Icons -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

	<style>
		/* for service  */
		@@import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap');

		.carousel-item {
			height: 90vh; /* تقليل الارتفاع إلى 60% من الشاشة */
			min-height: 400px;
			position: relative;
		}

			.carousel-item img {
				object-fit: cover;
				height: 100%;
				width: 100%;
				filter: brightness(60%); /* تعتيم الصورة لإبراز النص */
			}

		.carousel-caption-custom {
			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			text-align: center;
			color: #fff;
			z-index: 10;
		}

			.carousel-caption-custom h2 {
				font-size: 2.5rem;
				font-weight: bold;
			}

			.carousel-caption-custom p {
				font-size: 1.2rem;
			}


		h2 {
			text-align: center;
		}

		footer {
			background-color: #1e1e1e;
			color: white;
			padding-top: 70px;
			padding-bottom: 50px !important;
		}
		.btnWorkShop {
			padding: 10px 20px;
			font-size: 14px;
			background: #ff6b3d
		}



		/* About Section */
		.about {
			padding: 80px 0;
			background-color: white;
		}

		.section-title {
			text-align: center;
			margin-bottom: 60px;
			position: relative;
		}

			.section-title h2 {
				font-size: 32px;
				color: #063b5c; /* primary-color */
				position: relative;
				display: inline-block;
				padding-bottom: 15px;
			}

		/* .section-title h2::before { */
		/* 	content: ''; */
		/* 	position: absolute; */
		/* 	width: 50%; */
		/* 	height: 3px; */
		/* 	background-color: #15a1cf; /* secondary-color */
		/* 	bottom: 0; */
		/* 	right: 25%; */
		/* } */

		.about-content {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 40px;
		}

		.about-text {
			flex: 1;
			min-width: 300px;
		}

			.about-text h3 {
				font-size: 28px;
				margin-bottom: 20px;
				color: #063b5c; /* primary-color */
			}

			.about-text p {
				margin-bottom: 20px;
				line-height: 1.8;
				font-size: 16px;
			}

		.about-image {
			flex: 1;
			min-width: 300px;
			position: relative;
			border-radius: 10px;
			overflow: hidden;
			box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1); /* shadow */
		}

			.about-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 1s ease;
			}

			.about-image:hover img {
				transform: scale(1.05);
			}





		/* Services Section */
		.services-showcase {
			padding: 100px 0;
			background-color: #ffffff;
			position: relative;
			overflow: hidden;
		}

			.services-showcase:before {
				content: "";
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				height: 200px;
				background: linear-gradient(to bottom right, #f5f9ff 0%, #f5f9ff 50%, transparent 50%);
				z-index: 1;
			}

			.services-showcase .container {
				position: relative;
				z-index: 2;
				max-width: 1200px;
				margin: 0 auto;
				padding: 0 20px;
			}

		.section-title {
			text-align: center;
			margin-bottom: 60px;
		}

			.section-title h2 {
				font-size: 36px;
				font-weight: 700;
				color: #063b5c;
				margin-bottom: 15px;
				position: relative;
				display: inline-block;
			}

		.title-decoration {
			width: 80px;
			height: 4px;
			background: linear-gradient(to right, #15a1cf, #ff6b3d);
			margin: 0 auto;
			border-radius: 5px;
		}

		.service-row {
			display: flex;
			align-items: center;
			margin-bottom: 80px;
			transition: all 0.5s ease;
		}

			.service-row:last-child {
				margin-bottom: 0;
			}

			.service-row.reverse {
				flex-direction: row-reverse;
			}

		.service-illustration {
			flex: 0 0 40%;
			display: flex;
			justify-content: center;
			align-items: center;
		}

		.illustration-container {
			width: 200px;
			height: 200px;
			border-radius: 50%;
			background: linear-gradient(135deg, #e3f2fd, #bbdefb);
			display: flex;
			justify-content: center;
			align-items: center;
			box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
			position: relative;
			z-index: 1;
			transition: all 0.5s ease;
		}

		.service-row:nth-child(even) .illustration-container {
			background: linear-gradient(135deg, #fff8e1, #ffecb3);
		}

		.service-row:nth-child(3) .illustration-container {
			background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
		}

		.illustration-container:before {
			content: "";
			position: absolute;
			width: 220px;
			height: 220px;
			border-radius: 50%;
			border: 7px dashed rgba(21, 161, 207, 0.3);
			animation: spin 20s linear infinite;
		}

		.service-row:hover .illustration-container {
			transform: scale(1.1);
		}

		.illustration-container i {
			font-size: 80px;
			color: #063b5c;
		}

		.service-details {
			flex: 0 0 60%;
			padding: 0 30px;
		}

			.service-details h3 {
				font-size: 24px;
				font-weight: 600;
				color: #063b5c;
				margin-bottom: 15px;
				position: relative;
				padding-right: 20px;
			}

				.service-details h3:before {
					content: "";
					position: absolute;
					right: 0;
					top: 50%;
					width: 10px;
					height: 10px;
					border-radius: 50%;
					background-color: #15a1cf;
					transform: translateY(-50%);
				}

			.service-details p {
				font-size: 16px;
				line-height: 1.8;
				margin-bottom: 20px;
				color: #555;
			}

		.service-features {
			list-style: none;
			padding: 0;
			margin-bottom: 25px;
		}

			.service-features li {
				margin-bottom: 10px;
				font-size: 15px;
				display: flex;
				align-items: center;
			}

				.service-features li i {
					margin-left: 10px;
					color: #15a1cf;
					font-size: 16px;
				}

		.main-btn {
			display: inline-block;
			padding: 12px 30px;
			background: linear-gradient(to right, #15a1cf, #1c8eb7);
			color: #fff;
			border-radius: 30px;
			font-weight: 600;
			text-decoration: none;
			transition: all 0.3s ease;
			position: relative;
			overflow: hidden;
			z-index: 1;
		}

			.main-btn:before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				width: 0%;
				height: 100%;
				background: linear-gradient(to right, #1bb6d6, #1bb6d6);
				transition: all 0.5s ease;
				z-index: -1;
			}

			.main-btn:hover:before {
				width: 100%;
			}

			.main-btn:hover {
				box-shadow: 0 5px 15px rgba(255, 107, 61, 0.3);
			}

			.main-btn i {
				margin-right: 5px;
				transition: transform 0.3s ease;
			}

			.main-btn:hover i {
				transform: translateX(-5px);
			}

		@@keyframes spin {
			from {
				transform: rotate(0deg);
			}

			to {
				transform: rotate(360deg);
			}
		}

		/* Responsive adjustments */
		@@media screen and (max-width: 992px) {
			.service-row, .service-row.reverse {
				flex-direction: column;
				text-align: center;
			}

			.service-illustration {
				margin-bottom: 30px;
			}

			.service-details h3 {
				padding-right: 0;
			}

				.service-details h3:before {
					display: none;
				}

			.service-features li {
				justify-content: center;
			}
		}

		@@media screen and (max-width: 576px) {
			.services-showcase {
				padding: 60px 0;
			}

			.section-title h2 {
				font-size: 28px;
			}

			.service-details h3 {
				font-size: 22px;
			}

			.illustration-container {
				width: 160px;
				height: 160px;
			}

				.illustration-container:before {
					width: 180px;
					height: 180px;
				}

				.illustration-container i {
					font-size: 60px;
				}
		}

		/* End Services Section */


		/* Latest Workshops */
		.latest-workshops {
			padding: 80px 0;
			background-color: #f9f9f9; /* خلفية بيضاء فاتحة */
		}

		.workshops-container {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 30px;
		}

		.workshop-card {
			background-color: white;
			border-radius: 10px;
			overflow: hidden;
			width: 350px;
			box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1); /* الظل */
			transition: all 0.3s ease; /* الانتقال */
			opacity: 1;
			transform: translateY(10px);
		}

			.workshop-card:hover {
				transform: translateY(-5px);
				box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
			}

		.workshop-image {
			height: 200px;
			position: relative;
			overflow: hidden;
		}

			.workshop-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.5s ease;
			}

		.workshop-card:hover .workshop-image img {
			transform: scale(1.1);
		}

		.workshop-date {
			position: absolute;
			top: 15px;
			right: 15px;
			background-color: #ff6b3d; /* اللون المميز */
			color: white;
			padding: 5px 10px;
			border-radius: 5px;
			font-weight: 500;
			font-size: 14px;
		}

		.workshop-content {
			padding: 20px;
		}

			.workshop-content h3 {
				font-size: 20px;
				margin-bottom: 10px;
				color: #063b5c; /* اللون الأساسي */
			}

		.workshop-details {
			display: flex;
			margin-bottom: 15px;
			font-size: 14px;
			color: #666;
		}

		.workshop-detail {
			display: flex;
			align-items: center;
			margin-left: 15px;
		}

			.workshop-detail i {
				margin-left: 5px;
				color: #15a1cf; /* اللون الثانوي */
			}

		.workshop-content p {
			line-height: 1.6;
			margin-bottom: 15px;
			font-size: 14px;
		}

		/* End Latest Workshops */





	

		/* End Partners */


		/* Stats Section */
		.stats {
			padding: 60px 0;
			background-color: #063b5c; /* var(--primary-color) */
			color: white;
		}

		.stats-container {
			display: flex;
			flex-wrap: wrap;
			justify-content: space-around;
		}

		.stat-item {
			text-align: center;
			margin: 20px;
			min-width: 200px;
			opacity: 1;
			transform: translateY(20px);
			transition: all 0.3s ease; /* var(--transition) */
		}

		.stat-icon {
			font-size: 40px;
			margin-bottom: 15px;
			color: #ff6b3d; /* var(--accent-color) */
		}

		.stat-number {
			font-size: 36px;
			font-weight: 700;
			margin-bottom: 10px;
		}

		.stat-text {
			font-size: 16px;
			font-weight: 500;
		}

		/* CTA Section */
		.cta {
			padding: 80px 0;
			background-color: #063b5c; /* بدل var(--primary-color) */
			color: white;
			text-align: center;
		}

		.cta-content {
			max-width: 700px;
			margin: 0 auto;
		}

			.cta-content h2 {
				font-size: 32px;
				margin-bottom: 20px;
			}

			.cta-content p {
				margin-bottom: 30px;
				line-height: 1.7;
			}

		.cta-buttons {
			display: flex;
			justify-content: center;
			gap: 20px;
		}

		.cta-btn {
			padding: 12px 30px;
			border-radius: 5px;
			text-decoration: none;
			font-weight: 600;
			transition: all 0.3s ease; /* بدل var(--transition) */
		}

		.primary-btn {
			background-color: #ff6b3d; /* بدل var(--accent-color) */
			color: white;
		}

			.primary-btn:hover {
				background-color: #e55a2e;
				transform: translateY(-3px);
				box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
			}

		.secondary-btn {
			background-color: transparent;
			color: white;
			border: 2px solid white;
		}

			.secondary-btn:hover {
				background-color: white;
				color: #063b5c; /* بدل var(--primary-color) */
				transform: translateY(-3px);
				box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
			}


		/* ENd CTA Section */




		/* Animation Keyframes */
		@@keyframes fadeInUp {
			from {
				opacity: 0;
				transform: translateY(20px);
			}

			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		@@keyframes ticker {
			0% {
				transform: translateX(100%);
			}

			100% {
				transform: translateX(-100%);
			}
		}

		@@keyframes partnerSlide {
			0% {
				transform: translateX(0);
			}

			100% {
				transform: translateX(-100%);
			}
		}

		/* Media Queries */
		@@media screen and (max-width: 992px) {
			.nav-links {
				position: fixed;
				top: 80px;
				right: -100%;
				width: 100%;
				height: calc(100vh - 80px);
				background-color: white;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				transition: all 0.3s ease; /* استبدال var(--transition) */
				z-index: 999;
			}

				.nav-links.active {
					right: 0;
				}

				.nav-links li {
					margin: 15px 0;
				}

			.hamburger {
				display: flex;
			}

			.navbar.active .hamburger span:nth-child(1) {
				transform: translateY(9px) rotate(45deg);
			}

			.navbar.active .hamburger span:nth-child(2) {
				opacity: 0;
			}

			.navbar.active .hamburger span:nth-child(3) {
				transform: translateY(-9px) rotate(-45deg);
			}

			.about-content {
				flex-direction: column;
			}

			.about-text,
			.about-image {
				width: 100%;
			}

			.slide-content h1 {
				font-size: 32px;
			}

			.slide-content p {
				font-size: 16px;
			}
		}

		@@media screen and (max-width: 768px) {
			.hero {
				height: 60vh;
			}

			.slide-content h1 {
				font-size: 28px;
			}

			.about-text h3 {
				font-size: 24px;
			}

			.section-title h2 {
				font-size: 28px;
			}

			.cta-content h2 {
				font-size: 28px;
			}

			.cta-buttons {
				flex-direction: column;
				align-items: center;
			}

			.cta-btn {
				width: 100%;
				margin-bottom: 10px;
			}
		}

		@@media screen and (max-width: 576px) {
			.hero {
				height: 50vh;
				margin-top: 70px;
			}

			.slide-content h1 {
				font-size: 24px;
				margin-bottom: 15px;
			}

			.slide-content p {
				font-size: 14px;
				margin-bottom: 20px;
			}

			.btn {
				padding: 10px 20px;
				font-size: 14px;
			}

			.stat-number {
				font-size: 30px;
			}

			.testimonial-quote {
				font-size: 16px;
				padding: 0 15px;
			}

			.footer-content {
				flex-direction: column;
			}

			.navbar {
				padding: 10px 0;
			}

			.ticker-title {
				position: relative;
				padding: 5px 10px;
				margin-bottom: 10px;
				text-align: center;
				display: block;
				width: fit-content;
			}

			.ticker-wrapper {
				margin-right: 0;
			}

			.news-ticker {
				padding: 10px 0;
				display: flex;
				flex-direction: column;
				align-items: center;
			}
		}

		/* News Ticker */
		.news-ticker {
			padding: 15px 0;
			background-color: #15a1cf; /* secondary-color */
			color: white;
			position: fixed; /* تم تغييرها من relative إلى fixed */
			overflow: hidden;
			bottom: 0; /* لجعلها في أسفل الصفحة */
			width: 100%; /* لتمتد على عرض الصفحة بالكامل */
			z-index: 1000; /* لضمان ظهورها فوق العناصر الأخرى */
		}

		.ticker-title {
			position: absolute;
			right: 0;
			top: 0;
			height: 100%;
			background-color: #ff6b3d; /* accent-color */
			color: white;
			padding: 15px 20px;
			font-weight: 700;
			display: flex;
			align-items: center;
			z-index: 2;
		}

		.ticker-wrapper {
			margin-right: 150px;
			overflow: hidden;
			height: 30px;
		}

		.ticker-news {
			display: flex;
			animation: ticker 30s linear infinite;
			white-space: nowrap;
		}

		.ticker-item {
			padding: 0 30px;
			display: flex;
			align-items: center;
		}

			.ticker-item i {
				margin-left: 8px;
			}

		@@keyframes ticker {
			0% {
				transform: translateX(100%);
			}

			100% {
				transform: translateX(-100%);
			}
		}


		/* قسم الأخبار */
		.containerN {
			max-width: 1200px;
			margin: 0 auto;
			padding: 0 20px;
		}

		/* Section Title Styles */
		.section-title {
			text-align: center;
			margin-bottom: 40px;
			position: relative;
		}

			.section-title h2 {
				font-size: 32px;
				margin: 0;
				padding-bottom: 10px;
				display: inline-block;
			}

		.title-decoration {
			width: 80px;
			height: 4px;
			background: linear-gradient(90deg, #ff6b3d, #e55a2e);
			margin: 10px auto 0;
			border-radius: 2px;
			animation: titleUnderline 2s ease-in-out infinite alternate;
		}

		@@keyframes titleUnderline {
			0% {
				transform: scaleX(0.8);
				background: linear-gradient(90deg, #ff6b3d, #e55a2e);
			}

			50% {
				transform: scaleX(1.2);
				background: linear-gradient(90deg, #e55a2e, #ff6b3d);
			}

			100% {
				transform: scaleX(0.8);
				background: linear-gradient(90deg, #ff6b3d, #e55a2e);
			}
		}

		/* Alternative News Layout - Timeline Style */
		.news-timeline {
			position: relative;
			margin: 40px 0;
		}

		.timeline-line {
			position: absolute;
			top: 0;
			bottom: 0;
			right: 20px;
			width: 4px;
			background: linear-gradient(to bottom, #ff6b3d, #e55a2e);
			border-radius: 2px;
		}

		.news-item {
			display: flex;
			margin-bottom: 30px;
			position: relative;
		}

		.news-date-badge {
			min-width: 80px;
			height: 80px;
			background-color: #fff;
			border-radius: 50%;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
			margin-left: 30px;
			z-index: 1;
			border: 3px solid #ff6b3d;
		}

