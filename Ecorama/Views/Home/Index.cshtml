		// slider

				// كود محسن للسلايدر
		document.addEventListener('DOMContentLoaded', function() {
			// تهيئة السلايدر
			const sliderImages = document.querySelectorAll('.slider-image');

			// التأكد من أن هناك صور
			if (sliderImages.length > 0) {
				// التأكد من أن الصورة الأولى نشطة
				sliderImages[0].classList.add('active');

				let currentIndex = 0;

				// دالة تغيير الصورة
				function changeSlide() {
					// إخفاء جميع الصور
					sliderImages.forEach(img => img.classList.remove('active'));

					// تحديث المؤشر
					currentIndex = (currentIndex + 1) % sliderImages.length;

					// إظهار الصورة الجديدة
					sliderImages[currentIndex].classList.add('active');

					console.log('Changed slide to:', currentIndex); // للتأكد من تنفيذ الدالة
				}

				// تبديل الصور كل 5 ثواني
				setInterval(changeSlide, 5000);
			}

			// تشغيل عداد الإحصائيات
			startCounter();
		});

		// دالة عداد الإحصائيات
		function startCounter() {
			const stats = document.querySelectorAll('.stat-number');

			stats.forEach(stat => {
				const target = parseInt(stat.getAttribute('data-count'));
				let count = 0;
				const increment = Math.ceil(target / 100);
				const duration = 2000; // مدة العد بالمللي ثانية
				const interval = duration / (target / increment);

				const counter = setInterval(() => {
					count += increment;

					if (count >= target) {
						stat.textContent = target;
						clearInterval(counter);
					} else {
						stat.textContent = count;
					}
				}, interval);
			});
		}

		 var swiper = new Swiper(".eduCoursesSwiper", {
		  slidesPerView: 1,
		  spaceBetween: 20,
		  loop: true,
		  pagination: {
			el: ".swiper-pagination",
			clickable: true,
		  },
		  navigation: {
			nextEl: ".swiper-button-next",
			prevEl: ".swiper-button-prev",
		  },
		  breakpoints: {
			768: {
			  slidesPerView: 2,
			},
			1024: {
			  slidesPerView: 3,
			},
		  },
		});


				document.addEventListener("DOMContentLoaded", function () {
			const slider = document.querySelector(".partners-slider");
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							slider.classList.add("animate");
						} else {
							slider.classList.remove("animate");
						}
					});
				},
				{
					threshold: 0.5, // يبدأ عندما يظهر نصف العنصر على الأقل
				}
			);

			const section = document.querySelector("#partners-section");
			if (section) {
				observer.observe(section);
			}
		});

	</script>




