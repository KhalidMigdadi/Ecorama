@model IEnumerable<Ecorama.Models.SliderItem>

@{
    ViewData["Title"] = "إدارة عناصر السلايدر";
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">
                        <i class="fas fa-sliders-h me-2"></i>
                        إدارة عناصر السلايدر
                    </h3>
                    <a asp-action="Create" class="btn btn-light">
                        <i class="fas fa-plus me-1"></i>
                        إضافة عنصر جديد
                    </a>
                </div>
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade-show">
                            <i class="fas fa-check-circle me-2"></i>
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle" id="sliderItemsTable">
                                <thead class="table-dark">
                                    <tr>
                                        <th width="80">الترتيب</th>
                                        <th width="60">الصورة</th>
                                        <th>العنوان</th>
                                        <th>الوصف</th>
                                        @if (Context.Session.GetString("UserEmail") == "EcoramaSuperAdmin@gmail.com")
                                        {
                                            <th width="100" class="text-center">الحالة</th>
                                        }
                                        <th width="200" class="text-center">الإجراءات</th>
                                    </tr>
                                </thead>
                                <tbody id="sortable-slider">
                                    @foreach (var item in Model)
                                    {
                                        <tr data-id="@item.Id" style="cursor: move;">
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-grip-vertical text-muted me-2" style="cursor: grab;"></i>
                                                    <input type="number" class="form-control form-control-sm order-input"
                                                           value="@item.Order" min="1" style="width: 60px;" />
                                                </div>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                {
                                                    <img src="@Url.Content(item.ImageUrl)" alt="@item.Title"
                                                         class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-light d-flex align-items-center justify-content-center"
                                                         style="width: 50px; height: 50px; border-radius: 0.375rem;">
                                                        <i class="fas fa-image text-muted"></i>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <strong>@Html.DisplayFor(modelItem => item.Title)</strong>
                                            </td>
                                            <td>
                                                <span class="text-muted">
                                                    @{
                                                        var shortDesc = item.Description?.Length > 80 ?
                                                        item.Description.Substring(0, 80) + "..." :
                                                        item.Description;
                                                    }
                                                    @shortDesc
                                                </span>
                                            </td>
                                            @if (Context.Session.GetString("UserEmail") == "EcoramaSuperAdmin@gmail.com")
                                            {
                                                <td class="text-center">
                                                    <div class="form-check form-switch d-flex justify-content-center">
                                                        <input class="form-check-input active-toggle" type="checkbox"
                                                        @(item.IsActive ? "checked" : "") data-id="@item.Id"
                                                               style="cursor: pointer;">
                                                    </div>
                                                </td>
                                            }
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Details" asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-info" title="عرض التفاصيل">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-outline-warning" title="تعديل">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    @if (Context.Session.GetString("UserEmail") == "EcoramaSuperAdmin@gmail.com")
                                                    {
                                                        <button class="btn btn-sm btn-outline-danger delete-btn"
                                                                data-id="@item.Id" title="حذف">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-3">
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i>
                                يمكنك سحب وإفلات الصفوف لإعادة ترتيب عناصر السلايدر، أو استخدام حقل الترتيب لتحديد الترتيب بدقة
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-sliders-h fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">لا توجد عناصر في السلايدر حالياً</h5>
                            <p class="text-muted">ابدأ بإضافة عنصر جديد للسلايدر الرئيسي</p>
                            <a asp-action="Create" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i>
                                إضافة أول عنصر
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize sortable
            const sortableElement = document.getElementById('sortable-slider');
            if (sortableElement) {
                const sortable = Sortable.create(sortableElement, {
                    animation: 150,
                    ghostClass: 'sortable-ghost',
                    chosenClass: 'sortable-chosen',
                    dragClass: 'sortable-drag',
                    handle: '.fa-grip-vertical',
                    onEnd: function(evt) {
                        // Update order inputs based on new positions
                        updateOrderInputs();

                        // Update each item's order individually
                        const rows = document.querySelectorAll('#sortable-slider tr');
                        rows.forEach((row, index) => {
                            const id = row.getAttribute('data-id');
                            const newOrder = index + 1;

                            fetch('@Url.Action("UpdateOrder")', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded',
                                },
                                body: `id=${id}&newOrder=${newOrder}`
                            });
                        });

                        showToast('تم حفظ الترتيب الجديد بنجاح', 'success');
                    }
                });
            }

            // تحديث الترتيب عند تغيير القيمة
            document.addEventListener('change', function(e) {
                if (e.target.classList.contains('order-input')) {
                    const id = e.target.closest('tr').getAttribute('data-id');
                    const newOrder = e.target.value;

                    fetch('@Url.Action("UpdateOrder")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: `id=${id}&newOrder=${newOrder}`
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('تم تحديث الترتيب بنجاح', 'success');
                        } else {
                            showToast('حدث خطأ أثناء تحديث الترتيب', 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showToast('حدث خطأ أثناء تحديث الترتيب', 'error');
                    });
                }
            });

            // تغيير حالة التنشيط
            document.addEventListener('change', function(e) {
                if (e.target.classList.contains('active-toggle')) {
                    const id = e.target.getAttribute('data-id');
                    const isChecked = e.target.checked;

                    fetch('@Url.Action("ToggleActive")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: `id=${id}`
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('تم تحديث الحالة بنجاح', 'success');
                        } else {
                            showToast('حدث خطأ أثناء تحديث الحالة', 'error');
                            e.target.checked = !isChecked; // إرجاع الحالة السابقة
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        e.target.checked = !isChecked; // إرجاع الحالة السابقة
                        showToast('حدث خطأ أثناء تحديث الحالة', 'error');
                    });
                }
            });

            // حذف العنصر
            document.addEventListener('click', function(e) {
                if (e.target.closest('.delete-btn')) {
                    const button = e.target.closest('.delete-btn');
                    const id = button.getAttribute('data-id');

                    if (confirm("هل أنت متأكد أنك تريد حذف هذا العنصر؟")) {
                        fetch(`/Slider/Delete/${id}`, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                            }
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                document.querySelector(`tr[data-id="${id}"]`).remove();
                                showToast("تم حذف العنصر بنجاح", 'success');
                            } else {
                                showToast("حدث خطأ أثناء حذف العنصر", 'error');
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            showToast("حدث خطأ أثناء حذف العنصر", 'error');
                        });
                    }
                }
            });
        });

        function updateOrderInputs() {
            const rows = document.querySelectorAll('#sortable-slider tr');
            rows.forEach((row, index) => {
                const orderInput = row.querySelector('.order-input');
                if (orderInput) {
                    orderInput.value = index + 1;
                }
            });
        }

        function showToast(message, type) {
            // Create toast element
            const toast = document.createElement('div');
            toast.className = `alert alert-${type === 'success' ? 'success' : 'danger'} position-fixed`;
            toast.style.cssText = 'top: 20px; right: 20px; z-index: 1060; min-width: 300px;';
            toast.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>
                ${message}
            `;

            document.body.appendChild(toast);

            // Remove toast after 3 seconds
            setTimeout(() => {
                toast.remove();
            }, 3000);
        }
    </script>

    <style>
        .sortable-ghost {
            opacity: 0.4;
        }

        .sortable-chosen {
            background-color: #f8f9fa;
        }

        .sortable-drag {
            background-color: #fff;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        #sortable-slider tr:hover {
            background-color: #f8f9fa;
        }

        .btn-group .btn {
            border-radius: 0.375rem;
            margin: 0 1px;
        }

        .table th {
            border-top: none;
            font-weight: 600;
        }

        .fade-show {
            animation: fadeIn 0.5s ease-in;
        }

        .fa-grip-vertical:hover {
            color: #007bff !important;
            cursor: grab;
        }

        .fa-grip-vertical:active {
            cursor: grabbing;
        }

        .form-switch .form-check-input:checked {
            background-color: #198754;
            border-color: #198754;
        }

        .order-input {
            transition: all 0.2s ease;
        }

            .order-input:focus {
                border-color: #007bff;
                box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            }

        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }
    </style>
}

@section Style {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
}