@model Announcement
@{
    ViewData["Title"] = Model?.Title ?? "تفاصيل الإعلان";
    var relatedAnnouncements = ViewBag.RelatedAnnouncements as List<Announcement>;
}

@section Style {
    <link rel="stylesheet" href="~/css/advertisements.css" />
    <link rel="stylesheet" href="~/css/NEWs.css" />
}

@if (Model != null)
{
    <div class="advertisement-details">
        <!-- رأس الصفحة -->
        <div class="news-header text-center">
            <div class="container position-relative">
                <h1 class="fw-bold mb-3 animate__animated animate__fadeInDown">تفاصيل الإعلان</h1>
                <p class="lead animate__animated animate__fadeInUp animate__delay-1s">معلومات كاملة عن الإعلان المحدد</p>
            </div>
        </div>

        <!-- محتوى التفاصيل -->
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <div class="ad-detail-card">
                        <div class="ad-detail-header">
                            <h2>@Html.DisplayFor(m => m.Title)</h2>
                           

                            <img src="@Url.Content("~/images/" + Model.ImageUrl)" alt="@Model.Title" class="img-fluid rounded"
                                 style="width: 100%; height: auto; object-fit: cover;"
                                 onerror="this.style.display='none';" />
                            @if (Model.CreatedAt.HasValue)
                            {
                                <div class="ad-meta">
                                    <span class="ad-date">
                                        <i class="far fa-calendar-alt"></i>
                                        @Model.CreatedAt.Value.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-SA"))
                                    </span>
                                    <span class="ad-views">
                                        <i class="far fa-eye"></i>
                                        @Random.Shared.Next(100, 500) مشاهدة
                                    </span>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <div class="ad-detail-image">
                                <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded"
                                     onerror="this.style.display='none';">
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Content))
                        {
                            <div class="ad-detail-content">
                                @Html.Raw(Model.Content)
                            </div>
                        }
                        else
                        {
                            <div class="ad-detail-content">
                                <p class="text-muted">لا يوجد محتوى لهذا الإعلان.</p>
                            </div>
                        }

                        <div class="ad-detail-footer">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="ad-info">
                                    <small class="text-muted">
                                        رقم الإعلان: #@Model.Id
                                        @if (Model.CreatedAt.HasValue)
                                        {
                                            <span class="ms-3">
                                                تاريخ النشر: @Model.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm", new System.Globalization.CultureInfo("ar-SA"))
                                            </span>
                                        }
                                    </small>
                                </div>
                                <a href="@Url.Action("Advertisements", "News")" class="btn btn-primary">
                                    <i class="fas fa-arrow-left"></i> العودة إلى قائمة الإعلانات
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- إعلانات مشابهة -->
                   @*  @if (relatedAnnouncements != null && relatedAnnouncements.Any())
                    {
                        <div class="related-ads mt-5">
                            <h3 class="mb-4">إعلانات مشابهة</h3>
                            <div class="row">
                                @foreach (var related in relatedAnnouncements.Take(4))
                                {
                                    <div class="col-md-6 mb-4">
                                        <div class="ad-card">
                                            @if (!string.IsNullOrWhiteSpace(related.ImageUrl))
                                            {
                                                <img src="@related.ImageUrl" class="card-img-top" alt="@related.Title"
                                                     style="height: 150px; object-fit: cover;"
                                                     onerror="this.style.display='none';">
                                            }
                                            <div class="card-body">
                                                @if (related.CreatedAt.HasValue)
                                                {
                                                    <div class="ad-date">
                                                        <i class="far fa-calendar-alt me-2"></i>
                                                        @related.CreatedAt.Value.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-SA"))
                                                    </div>
                                                }
                                                <h5 class="card-title">@Html.DisplayFor(m => related.Title)</h5>
                                                @if (!string.IsNullOrWhiteSpace(related.Content))
                                                {
                                                    <p class="card-text">
                                                        @{
                                                            string truncatedContent = related.Content.Length > 100
                                                            ? Html.Raw(related.Content).ToString().Substring(0, 100) + "..."
                                                            : Html.Raw(related.Content).ToString();
                                                        }
                                                        @Html.Raw(truncatedContent)
                                                    </p>
                                                }
                                                <a href="@Url.Action("AdvertisementsDetails", "News", new { id = related.Id })"
                                                   class="read-more">التفاصيل</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    } *@
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container text-center mt-5">
        <div class="alert alert-warning">
            <h4>الإعلان غير موجود</h4>
            <p>الإعلان المطلوب غير متوفر أو تم حذفه.</p>
            <a href="@Url.Action("Advertisements", "News")" class="btn btn-primary">
                <i class="fas fa-arrow-left"></i> العودة إلى قائمة الإعلانات
            </a>
        </div>
    </div>
}