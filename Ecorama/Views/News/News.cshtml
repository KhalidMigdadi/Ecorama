
@{
    ViewData["Title"] = "News";
}

@section Style {
    <!-- Bootstrap 5 RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">

    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <link rel="stylesheet" href="~/css/NEWs.css" />
}

<div class="news-container">
    <!-- رأس الصفحة المتحرك -->
    <div class="news-header text-center">
        <div class="floating-shapes">
            <div class="shape" style="width: 100px; height: 100px; background: white; top: 20%; left: 10%; animation-delay: 0s;"></div>
            <div class="shape" style="width: 150px; height: 150px; background: var(--unhcr-blue); top: 60%; left: 80%; animation-delay: 2s;"></div>
            <div class="shape" style="width: 80px; height: 80px; background: white; top: 80%; left: 30%; animation-delay: 4s;"></div>
        </div>
        <div class="container position-relative">
            <h1 class="fw-bold mb-3 animate__animated animate__fadeInDown">أحدث أخبار الدورات وورش العمل - Ecorama</h1>
            <p class="lead animate__animated animate__fadeInUp animate__delay-1s">تابع قصص النجاح والتحديثات التعليمية للمفوضية حول العالم</p>
        </div>
    </div>

    <!-- شريط الأخبار العاجلة -->
    <div class="news-ticker animate__animated animate__fadeIn">
        <div class="container">
            <div class="ticker-content">
                <span class="ticker-item">إطلاق برنامج تدريب المدربين (ToT) في مخيم الزعتري</span>
                <span class="ticker-item">Ecorama تعلن منحة كاملة لدورة البرمجة للسيدات</span>
                <span class="ticker-item">انتهاء ورشة ريادة الأعمال للشباب اللاجئ في أوغندا بنجاح</span>
                <span class="ticker-item">فتح التسجيل لدورة التصميم الجرافيكي عبر الإنترنت – مايو 2025</span>
                <span class="ticker-item">تقرير جديد: 15 ألف خريج من برامج Ecorama خلال 2024</span>
            </div>
        </div>
    </div>

    <!-- شريط التحميل المتحرك -->
    <div class="loading-bar animate__animated animate__fadeIn animate__delay-1s">
        <div class="loading-progress"></div>
    </div>

    <!-- محتوى الأخبار -->
    <div class="container">
        <div class="row">
            <!-- خبر رئيسي -->
            <div class="col-lg-6 mb-4">
                <div class="news-card">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&fit=crop&w=1000&q=80" class="card-img-top" alt="دورة رئيسية">
                        <span class="category-badge">دورة جديدة</span>
                    </div>
                    <div class="card-body">
                        <div class="news-date">
                            <i class="far fa-calendar-alt me-2"></i> 11 مايو 2025
                        </div>
                        <h3 class="card-title">بدء التسجيل في دورة المهارات الرقمية للاجئين 2025</h3>
                        <p class="card-text">أعلنت منصة Ecorama عن فتح باب التسجيل لأحدث دوراتها في المهارات الرقمية، والتي ستُقدَّم بنظام التعليم المدمج لمدة 8 أسابيع وتشمل شهادات مُعتمَدة.</p>
                        <a asp-controller="News" asp-action="NewsDetails" @* asp-route-id="1" *@ class="read-more">اقرأ المزيد</a>
                    </div>
                </div>
            </div>

            <!-- أخبار ثانوية -->
            <div class="col-lg-6">
                <div class="row">
                    <!-- خبر 1 -->
                    <div class="col-md-6 mb-4">
                        <div class="news-card">
                            <img src="https://images.unsplash.com/photo-1503676382389-4809596d5290?auto=format&fit=crop&w=1000&q=80" class="card-img-top" alt="ورشة ريادة الأعمال">
                            <div class="card-body">
                                <div class="news-date">
                                    <i class="far fa-calendar-alt me-2"></i> 8 مايو 2025
                                </div>
                                <h5 class="card-title">اختتام ورشة ريادة الأعمال للشباب في عمّان</h5>
                                <p class="card-text">شارك 30 مشاركاً في ورشة مكثفة لتطوير نماذج أعمال مبتكرة تدعم مجتمعاتهم.</p>
                                <a href="/News/Details/2" class="read-more">اقرأ المزيد</a>
                            </div>
                        </div>
                    </div>

                    <!-- خبر 2 -->
                    <div class="col-md-6 mb-4">
                        <div class="news-card">
                            <img src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=1000&q=80" class="card-img-top" alt="تصميم جرافيكي">
                            <div class="card-body">
                                <div class="news-date">
                                    <i class="far fa-calendar-alt me-2"></i> 5 مايو 2025
                                </div>
                                <h5 class="card-title">منحة كاملة لدورة التصميم الجرافيكي للسيدات</h5>
                                <p class="card-text">توفر المنحة تدريباً عملياً على برامج التصميم ويُختتم بمعرض أعمال.</p>
                                <a href="/News/Details/3" class="read-more">اقرأ المزيد</a>
                            </div>
                        </div>
                    </div>

                    <!-- خبر 3 -->
                    <div class="col-md-6 mb-4">
                        <div class="news-card">
                            <img src="https://www.petra.gov.jo/upload/1747044409173.jpg" class="card-img-top" alt="تدريب المدربين">
                            <div class="card-body">
                                <div class="news-date">
                                    <i class="far fa-calendar-alt me-2"></i> 2 مايو 2025
                                </div>
                                <h5 class="card-title">تخريج الدفعة الأولى من برنامج ToT في الزعتري</h5>
                                <p class="card-text">أكثر من 20 مدرّباً جديداً سيقودون جلسات تعليمية داخل المخيم.</p>
                                <a href="/News/Details" class="read-more">اقرأ المزيد</a>
                            </div>
                        </div>
                    </div>

                    <!-- خبر 4 -->
                    <div class="col-md-6 mb-4">
                        <div class="news-card">
                            <img src="https://images.unsplash.com/photo-1529107386315-e1a2ed48a620?auto=format&fit=crop&w=1000&q=80" class="card-img-top" alt="جلسات سوق العمل">
                            <div class="card-body">
                                <div class="news-date">
                                    <i class="far fa-calendar-alt me-2"></i> 28 أبريل 2025
                                </div>
                                <h5 class="card-title">جلسات توعية مهنية عن سوق العمل المحلي</h5>
                                <p class="card-text">تهدف الجلسات إلى ربط الخريجين بفرص عمل وشركات شريكة.</p>
                                <a href="/News/Details/5" class="read-more">اقرأ المزيد</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- المزيد من الأخبار -->
        <div class="row mt-4">
            <div class="col-12">
                <h3 class="mb-4 animate__animated animate__fadeIn" style="color: var(--unhcr-dark-blue);">قصص نجاح ودورات سابقة</h3>
            </div>

            <!-- خبر إضافي 1 -->
            <div class="col-md-4 mb-4">
                <div class="news-card">
                    <img src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=1000&q=80" class="card-img-top" alt="حملات تطعيم">
                    <div class="card-body">
                        <div class="news-date">
                            <i class="far fa-calendar-alt me-2"></i> 20 أبريل 2025
                        </div>
                        <h5 class="card-title">انتهاء حملة “التعلم من أجل الصحة” بنجاح</h5>
                        <p class="card-text">استفاد 1٬200 لاجئ من سلسلة ورش توعية صحية عبر التعليم الرقمي.</p>
                        <a href="/News/Details/6" class="read-more">اقرأ المزيد</a>
                    </div>
                </div>
            </div>

            <!-- خبر إضافي 2 -->
            <div class="col-md-4 mb-4">
                <div class="news-card">
                    <img src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=1000&q=80" class="card-img-top" alt="تمكين المرأة">
                    <div class="card-body">
                        <div class="news-date">
                            <i class="far fa-calendar-alt me-2"></i> 15 أبريل 2025
                        </div>
                        <h5 class="card-title">برنامج تمكين المرأة يخرّج 300 مشاركة</h5>
                        <p class="card-text">تلقت المشاركات تدريباً على إدارة المشروعات الصغيرة والتسويق الرقمي.</p>
                        <a href="/News/Details/7" class="read-more">اقرأ المزيد</a>
                    </div>
                </div>
            </div>

            <!-- خبر إضافي 3 -->
            <div class="col-md-4 mb-4">
                <div class="news-card">
                    <img src="https://images.unsplash.com/photo-1466692476868-aef1dfb1e735?auto=format&fit=crop&w=1000&q=80" class="card-img-top" alt="تغير مناخي">
                    <div class="card-body">
                        <div class="news-date">
                            <i class="far fa-calendar-alt me-2"></i> 10 أبريل 2025
                        </div>
                        <h5 class="card-title">تقرير: التغير المناخي والتعليم المهني</h5>
                        <p class="card-text">دراسة حول دور التدريب المهني في تعزيز قدرة المجتمعات المتأثرة بالمناخ.</p>
                        <a href="/News/Details/8" class="read-more">اقرأ المزيد</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // ظهور البطاقات بالتتابع عند التمرير
        document.addEventListener('DOMContentLoaded', function () {
            const newsCards = document.querySelectorAll('.news-card');

            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry, index) => {
                    if (entry.isIntersecting) {
                        setTimeout(() => {
                            entry.target.classList.add('visible');
                        }, index * 150);
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.1 });

            newsCards.forEach(card => {
                observer.observe(card);
            });

            // تأثير التمرير السلس للروابط
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    document.querySelector(this.getAttribute('href')).scrollIntoView({
                        behavior: 'smooth'
                    });
                });
            });
        });

        // تغيير لون الخلفية عند التمرير
        window.addEventListener('scroll', function () {
            const header = document.querySelector('.news-header');
            const scrollPosition = window.scrollY;

            if (scrollPosition > 50) {
                header.style.background = `linear-gradient(135deg, var(--unhcr-dark-blue), var(--unhcr-blue))`;
            } else {
                header.style.background = `linear-gradient(135deg, var(--unhcr-blue), var(--unhcr-dark-blue))`;
            }
        });
    </script>
}


