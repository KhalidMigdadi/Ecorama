



@model IEnumerable<Ecorama.Models.News>

@{
    ViewData["Title"] = "News";
    var hasMoreticker = Model.Count() > 5;
    var displayedticker = Model.OrderByDescending(o => o.CreatedAt).Take(5).ToList(); // هنا عرفه مرة وحدة
}

@section Style {
    <!-- Bootstrap 5 RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">

    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <link rel="stylesheet" href="~/css/NEWs.css" />
}

<div class="news-container">
    <!-- رأس الصفحة المتحرك -->
    <div class="news-header text-center">
        <div class="floating-shapes">
            <div class="shape" style="width: 100px; height: 100px; background: white; top: 20%; left: 10%; animation-delay: 0s;"></div>
            <div class="shape" style="width: 150px; height: 150px; background: var(--unhcr-blue); top: 60%; left: 80%; animation-delay: 2s;"></div>
            <div class="shape" style="width: 80px; height: 80px; background: white; top: 80%; left: 30%; animation-delay: 4s;"></div>
        </div>
        <div class="container position-relative">
            <h1 class="fw-bold mb-3 animate__animated animate__fadeInDown">أحدث أخبار الدورات وورش العمل - Ecorama</h1>
            <p class="lead animate__animated animate__fadeInUp animate__delay-1s">تابع قصص النجاح والتحديثات التعليمية للمفوضية حول العالم</p>
        </div>
    </div>

    <!-- شريط الأخبار العاجلة -->
    <div class="news-ticker animate__animated animate__fadeIn">
        <div class="container">
            <div class="ticker-content">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in displayedticker)
                    {
                        <span class="ticker-item">@item.Title</span>
                    }
                }
                else
                {
                    <span class="ticker-item">لا يوجد اخبار حالياً</span>
                }
            </div>
        </div>
    </div>

    <!-- شريط التحميل المتحرك -->
    <div class="loading-bar animate__animated animate__fadeIn animate__delay-1s">
        <div class="loading-progress"></div>
    </div>

    <!-- محتوى الأخبار -->
    <div class="container">
        @if (Model != null && Model.Any())
        {
            <div class="row">
                <!-- خبر رئيسي -->
                <div class="col-lg-6 mb-4">
                    <div class="news-card">
                        <div class="position-relative">
                            <img src="~/img/news/@displayedticker.First().ImageUrl" class="card-img-top" alt="دورة رئيسية">
                        </div>
                        <div class="card-body">
                            <div class="news-date">
                                <i class="far fa-calendar-alt me-2"></i> @displayedticker.First().CreatedAt
                            </div>
                            <h3 style="display: block; padding-bottom: 10px;" class="card-title">@displayedticker.First().Title</h3>
                            <p class="card-text" style="display: -webkit-box; -webkit-line-clamp: 10; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; padding-top: 25px;">
                                @displayedticker.First().Content
                            </p>
                            <a asp-controller="News" asp-action="NewsDetails" asp-route-id="@displayedticker.First().Id" class="read-more">اقرأ المزيد</a>
                        </div>
                    </div>
                </div>

                <!-- أخبار ثانوية -->
                <div class="col-lg-6">
                    <div class="row">
                        @foreach (var item in displayedticker.Skip(1))
                        {
                            <div class="col-md-6 mb-4">
                                <div class="news-card">
                                    <img src="~/img/news/@item.ImageUrl" class="card-img-top" alt="@item.Title">
                                    <div class="card-body">
                                        <div class="news-date">
                                            <i class="far fa-calendar-alt me-2"></i>
                                            @item.CreatedAt
                                        </div>
                                        <h5 style="padding-bottom: 10px;" class="card-title">@item.Title</h5>
                                        <p class="card-text" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; padding-top: 25px;">
                                            @item.Content
                                        </p>
                                        <a asp-controller="News" asp-action="NewsDetails" asp-route-id="@item.Id" class="read-more">اقرأ المزيد</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- المزيد من الأخبار -->
            @if (Model.Count() > 5)
            {
                <div class="row mt-4">
                    <div class="col-12">
                        <h3 class="mb-4 animate__animated animate__fadeIn" style="color: var(--unhcr-dark-blue);">
                            قصص نجاح ودورات سابقة
                        </h3>
                    </div>

                    @foreach (var news in Model.Skip(5))
                    {
                        <div class="col-md-4 mb-4">
                            <div class="news-card">
                                <img src="~/img/news/@news.ImageUrl" class="card-img-top" alt="@news.Title">
                                <div class="card-body">
                                    <div class="news-date">
                                        <i class="far fa-calendar-alt me-2"></i> @news.CreatedAt
                                    </div>
                                    <h5 style="padding-bottom: 10px;" class="card-title">@news.Title</h5>
                                    <p class="card-text" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; padding-top: 25px;">
                                        @news.Content
                                    </p>
                                    <a asp-controller="News" asp-action="NewsDetails" asp-route-id="@news.Id" class="read-more">اقرأ المزيد</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="news-card">
                <h4 class="my-4">لا يوجد اخبار لعرضها</h4>
                <p class="text-muted mb-4">لم يتم اضافة اي خبر الى معرض الاخبار</p>
            </div>
        }
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // ظهور البطاقات بالتتابع عند التمرير
        document.addEventListener('DOMContentLoaded', function () {
            const newsCards = document.querySelectorAll('.news-card');

            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry, index) => {
                    if (entry.isIntersecting) {
                        setTimeout(() => {
                            entry.target.classList.add('visible');
                        }, index * 150);
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.1 });

            newsCards.forEach(card => {
                observer.observe(card);
            });

            // تأثير التمرير السلس للروابط
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    document.querySelector(this.getAttribute('href')).scrollIntoView({
                        behavior: 'smooth'
                    });
                });
            });
        }); // <-- هذا نهاية الدالة بدون أي أقواس زايدة بعدها
    </script>

}
