@model List<Announcement>
@{
	ViewData["Title"] = "Advertisements";
}

@section Style {
	<link rel="stylesheet" href="~/css/advertisements.css" />
	<link rel="stylesheet" href="~/css/NEWs.css" />
}

<div class="advertisements-container">
	<!-- رأس الصفحة -->
	<div class="news-header text-center">
		<div class="floating-shapes">
			<div class="shape" style="width: 100px; height: 100px; background: white; top: 20%; left: 10%; animation-delay: 0s;"></div>
			<div class="shape" style="width: 150px; height: 150px; background: var(--unhcr-blue); top: 60%; left: 80%; animation-delay: 2s;"></div>
			<div class="shape" style="width: 80px; height: 80px; background: white; top: 80%; left: 30%; animation-delay: 4s;"></div>
		</div>
		<div class="container position-relative">
			<h1 class="fw-bold mb-3 animate__animated animate__fadeInDown">الدورات وورش العمل - Ecorama</h1>
			<p class="lead animate__animated animate__fadeInUp animate__delay-1s">تابع أحدث الدورات التدريبية وورش العمل التعليمية المقدمة من المفوضية</p>
		</div>
	</div>

	<!-- فلترة الإعلانات -->
	<div class="container mb-4 animate__animated animate__fadeIn">
		<div class="row">
			<div class="col-md-8">
				<div class="search-box">
					<input type="text" class="form-control" placeholder="ابحث عن دورة أو ورشة..." id="searchInput">
					<button class="btn btn-primary"><i class="fas fa-search"></i></button>
				</div>
			</div>
			<div class="col-md-4">
			
			</div>
		</div>
	</div>

	<!-- قائمة الدورات -->
	<div class="container">
		@if (Model != null && Model.Any())
		{
			<div class="row">
				@{
					var mainAnnouncement = Model.FirstOrDefault();
					var otherAnnouncements = Model.Skip(1).Take(4).ToList();
					var previousAnnouncements = Model.Skip(5).ToList();
				}

				@if (mainAnnouncement != null)
				{
					<!-- دورة رئيسية -->
					<div class="col-lg-6 mb-4">
						<div class="ad-card main-ad">
							<div class="position-relative">
								<img src="~/images/@mainAnnouncement.ImageUrl"
									 class="card-img-top" alt="@mainAnnouncement.Title">
								<span class="category-badge">إعلان رئيسي</span>
							</div>
							<div class="card-body">
								<div class="ad-date">
									<i class="far fa-calendar-alt me-2"></i> @mainAnnouncement.CreatedAt?.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-SA"))
								</div>
								<h3 class="card-title">@mainAnnouncement.Title</h3>
								<p class="card-text">@Html.Raw(mainAnnouncement.Content.Length > 150 ? mainAnnouncement.Content.Substring(0, 150) + "..." : mainAnnouncement.Content)</p>
								<div class="d-flex justify-content-between align-items-center">
									<a href="@Url.Action("AdvertisementsDetails","News", new { id = mainAnnouncement.Id })" class="read-more">التفاصيل</a>
									<span class="ad-views"><i class="far fa-eye"></i> @Random.Shared.Next(100, 500)</span>
								</div>
							</div>
						</div>
					</div>
				}

				<!-- الإعلانات الأخرى -->
				<div class="col-lg-6">
					<div class="row">
						@foreach (var announcement in otherAnnouncements)
						{
							<div class="col-md-6 mb-4">
								<div class="ad-card">
									<img src="~/images/@mainAnnouncement.ImageUrl"
										 class="card-img-top" alt="@announcement.Title">
									<div class="card-body">
										<div class="ad-date">
											<i class="far fa-calendar-alt me-2"></i> @announcement.CreatedAt?.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-SA"))
										</div>
										<h5 class="card-title">@announcement.Title</h5>
										<p class="card-text">@Html.Raw(announcement.Content.Length > 100 ? announcement.Content.Substring(0, 100) + "..." : announcement.Content)</p>
										<div class="d-flex justify-content-between align-items-center">
											<a href="@Url.Action("AdvertisementsDetails","News", new { id = announcement.Id })" class="read-more">التفاصيل</a>
											<span class="ad-views"><i class="far fa-eye"></i> @Random.Shared.Next(50, 300)</span>
										</div>
									</div>
								</div>
							</div>
						}
					</div>
				</div>
			</div>

			@if (previousAnnouncements.Any())
			{
				<!-- إعلانات سابقة -->
				<div class="row mt-4">
					<div class="col-12">
						<h3 class="mb-4" style="color: var(--unhcr-dark-blue);">إعلانات سابقة</h3>
					</div>

					@foreach (var announcement in previousAnnouncements)
					{
						<div class="col-md-4 mb-4">
							<div class="ad-card">
								<img src="~/images/@mainAnnouncement.ImageUrl"
									 class="card-img-top" alt="@announcement.Title">
								<div class="card-body">
									<div class="ad-date">
										<i class="far fa-calendar-alt me-2"></i> @announcement.CreatedAt?.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-SA"))
									</div>
									<h5 class="card-title">@announcement.Title</h5>
									<p class="card-text">@Html.Raw(announcement.Content.Length > 100 ? announcement.Content.Substring(0, 100) + "..." : announcement.Content)</p>
									<div class="d-flex justify-content-between align-items-center">
										<a href="@Url.Action("AdvertisementsDetails","News", new { id = announcement.Id })" class="read-more">التفاصيل</a>
										<span class="ad-views"><i class="far fa-eye"></i> @Random.Shared.Next(50, 250)</span>
									</div>
								</div>
							</div>
						</div>
					}
				</div>
			}
		}
		else
		{
			<!-- رسالة في حالة عدم وجود إعلانات -->
			<div class="row">
				<div class="col-12 text-center">
					<div class="alert alert-info">
						<h4>لا توجد إعلانات حالياً</h4>
						<p>سيتم إضافة إعلانات جديدة قريباً</p>
					</div>
				</div>
			</div>
		}

		<!-- ترقيم الصفحات -->
		@if (Model != null && Model.Count > 10)
		{
			<nav aria-label="Page navigation">
				<ul class="pagination justify-content-center">
					<li class="page-item disabled">
						<a class="page-link" href="#" tabindex="-1">السابق</a>
					</li>
					<li class="page-item active"><a class="page-link" href="#">1</a></li>
					<li class="page-item"><a class="page-link" href="#">2</a></li>
					<li class="page-item"><a class="page-link" href="#">3</a></li>
					<li class="page-item">
						<a class="page-link" href="#">التالي</a>
					</li>
				</ul>
			</nav>
		}
	</div>
</div>

@section Scripts {
    <script>
        // كود JavaScript لصفحة الدورات
			 document.addEventListener('DOMContentLoaded', function () {
			const adCards = document.querySelectorAll('.ad-card');
			const searchInput = document.getElementById('searchInput');

			// Animation للكروت (الكود الحالي)
			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry, index) => {
					if (entry.isIntersecting) {
						setTimeout(() => {
							entry.target.classList.add('visible');
						}, index * 100);
						observer.unobserve(entry.target);
					}
				});
			}, { threshold: 0.1 });

			adCards.forEach(card => {
				observer.observe(card);
			});

			// وظيفة البحث عن الإعلانات
			function searchAnnouncements() {
				const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';

				adCards.forEach(card => {
					const titleElement = card.querySelector('.card-title');
					const contentElement = card.querySelector('.card-text');
					const parentCol = card.closest('.col-lg-6, .col-md-6, .col-md-4');

					if (!titleElement || !contentElement || !parentCol) {
						return;
					}

					const title = titleElement.textContent.toLowerCase();
					const content = contentElement.textContent.toLowerCase();

					// البحث في العنوان والمحتوى
					const matchesSearch = !searchTerm ||
										title.includes(searchTerm) ||
										content.includes(searchTerm);

					// إظهار أو إخفاء الكارد
					if (matchesSearch) {
						parentCol.style.display = 'block';
						parentCol.style.opacity = '1';
						// إعادة تطبيق الأنيميشن إذا لزم الأمر
						if (!card.classList.contains('visible')) {
							card.classList.add('visible');
						}
					} else {
						parentCol.style.display = 'none';
					}
				});

				// إظهار رسالة إذا لم توجد نتائج
				checkNoResults(searchTerm);
			}

			// فحص عدم وجود نتائج
			function checkNoResults(searchTerm) {
				const visibleCards = document.querySelectorAll('.ad-card').length;
				const displayedCards = Array.from(document.querySelectorAll('.ad-card')).filter(card => {
					const parentCol = card.closest('.col-lg-6, .col-md-6, .col-md-4');
					return parentCol && parentCol.style.display !== 'none';
				}).length;

				// إزالة رسالة "لا توجد نتائج" السابقة
				const existingNoResults = document.querySelector('.no-results-message');
				if (existingNoResults) {
					existingNoResults.remove();
				}

				// إضافة رسالة "لا توجد نتائج" إذا لزم الأمر
				if (displayedCards === 0 && searchTerm) {
					const container = document.querySelector('.advertisements-container .container');
					const noResultsDiv = document.createElement('div');
					noResultsDiv.className = 'no-results-message alert alert-info text-center mt-4';
					noResultsDiv.innerHTML = `
						<h4>لا توجد نتائج مطابقة</h4>
						<p>لم يتم العثور على نتائج للبحث عن: "<strong>${searchTerm}</strong>"</p>
						<button class="btn btn-outline-primary" onclick="clearSearch()">مسح البحث</button>
					`;
					container.appendChild(noResultsDiv);
				}
			}

			// مسح البحث
			window.clearSearch = function() {
				if (searchInput) {
					searchInput.value = '';
				}
				if (categoryFilter) {
					categoryFilter.selectedIndex = 0;
				}
				filterAnnouncements();
			};

			// Event listeners للبحث والفلترة
			if (searchInput) {
				searchInput.addEventListener('input', filterAnnouncements);

				// إضافة مسح سريع بالضغط على Escape
				searchInput.addEventListener('keydown', function(e) {
					if (e.key === 'Escape') {
						searchInput.value = '';
						filterAnnouncements();
					}
				});
			}

			if (categoryFilter) {
				categoryFilter.addEventListener('change', filterAnnouncements);
			}

			// تشغيل الفلترة مرة واحدة في البداية للتأكد من ظهور جميع الكاردات
			setTimeout(() => {
				filterAnnouncements();
			}, 500);
		});
    </script>
}


