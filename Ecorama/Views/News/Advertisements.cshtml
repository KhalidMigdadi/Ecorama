                        </div>
                        <h5 class="card-title">مبادرة التعليم عن بُعد للنازحين</h5>
                        <p class="card-text">تجربة رائدة في توفير تعليم رقمي مجاني للطلاب في المناطق النائية.</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <a href="/Advertisements/Details/6" class="read-more">التفاصيل</a>
                            <span class="ad-views"><i class="far fa-eye"></i> 142</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- سابق 2 -->
            <div class="col-md-4 mb-4">
                <div class="ad-card">
                    <img src="https://eduhub21.com/wp-content/uploads/2024/08/%D9%85%D8%A7-%D9%87%D9%8A-%D8%A7%D9%87%D9%85-%D8%A7%D9%84%D9%85%D9%87%D8%A7%D8%B1%D8%A7%D8%AA-%D8%A7%D9%84%D9%84%D8%BA%D9%88%D9%8A%D9%87%D8%9F-768x768.jpg.webp" class="card-img-top" alt="دورة تدريب المدربين">

                    <div class="card-body">
                        <div class="ad-date">
                            <i class="far fa-calendar-alt me-2"></i> 15 أبريل 2025
                        </div>
                        <h5 class="card-title">ورشة بناء المهارات اللغوية</h5>
                        <p class="card-text">تهدف الورشة لتقوية مهارات التواصل الشفهي والكتابي باللغة الإنجليزية.</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <a href="/Advertisements/Details/7" class="read-more">التفاصيل</a>
                            <span class="ad-views"><i class="far fa-eye"></i> 117</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- سابق 3 -->
            <div class="col-md-4 mb-4">
                <div class="ad-card">
                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRaniQdSgOeeN9s4DbRXaokPzpndb6i-tgoKw&s" class="card-img-top" alt="دورة تدريب المدربين">

                    <div class="card-body">
                        <div class="ad-date">
                            <i class="far fa-calendar-alt me-2"></i> 10 أبريل 2025
                        </div>
                        <h5 class="card-title">دورة العمل الإنساني للمبتدئين</h5>
                        <p class="card-text">مقدمة لفهم المبادئ الأساسية للعمل مع المنظمات غير الربحية.</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <a href="/Advertisements/Details/8" class="read-more">التفاصيل</a>
                            <span class="ad-views"><i class="far fa-eye"></i> 189</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ترقيم الصفحات -->
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1">السابق</a>
                </li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item">
                    <a class="page-link" href="#">التالي</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script>
        // كود JavaScript لصفحة الدورات
        document.addEventListener('DOMContentLoaded', function () {
            const adCards = document.querySelectorAll('.ad-card');

            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry, index) => {
                    if (entry.isIntersecting) {
                        setTimeout(() => {
                            entry.target.classList.add('visible');
                        }, index * 100);
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.1 });

            adCards.forEach(card => {
                observer.observe(card);
            });
        });
    </script>
}

