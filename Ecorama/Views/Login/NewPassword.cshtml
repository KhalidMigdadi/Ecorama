@{
	ViewData["Title"] = "NewPassword";
}

@section Style {
	<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
	<style>
		body {
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			min-height: 100vh;
			font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
		}

		.password-container {
			min-height: 100vh;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 20px;
		}

		.password-card {
			background: rgba(255, 255, 255, 0.95);
			border-radius: 20px;
			box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
			padding: 40px;
			width: 100%;
			max-width: 500px;
			backdrop-filter: blur(10px);
			border: 1px solid rgba(255, 255, 255, 0.2);
		}

		.password-icon {
			width: 80px;
			height: 80px;
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			margin: 0 auto 30px;
			box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
		}

			.password-icon i {
				font-size: 2rem;
				color: white;
			}

		.form-control {
			border: 2px solid #e1e5e9;
			border-radius: 12px;
			padding: 15px 50px 15px 20px;
			font-size: 16px;
			transition: all 0.3s ease;
			background: rgba(255, 255, 255, 0.9);
		}

			.form-control:focus {
				border-color: #667eea;
				box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
				background: white;
			}

		.password-input-group {
			position: relative;
		}

		.password-toggle {
			position: absolute;
			left: 15px;
			top: 50%;
			transform: translateY(-50%);
			background: none;
			border: none;
			color: #6c757d;
			cursor: pointer;
			z-index: 10;
			padding: 5px;
			border-radius: 5px;
			transition: all 0.3s ease;
		}

			.password-toggle:hover {
				color: #667eea;
				background: rgba(102, 126, 234, 0.1);
			}

		.btn-primary {
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			border: none;
			border-radius: 12px;
			padding: 15px 30px;
			font-size: 16px;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.5px;
			transition: all 0.3s ease;
			box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
		}

			.btn-primary:hover {
				transform: translateY(-2px);
				box-shadow: 0 15px 40px rgba(102, 126, 234, 0.4);
				background: linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%);
			}

		.btn-outline-secondary {
			border: 2px solid #6c757d;
			color: #6c757d;
			border-radius: 12px;
			padding: 12px 25px;
			font-weight: 600;
			transition: all 0.3s ease;
		}

			.btn-outline-secondary:hover {
				background: #6c757d;
				color: white;
				transform: translateY(-1px);
			}

		.alert {
			border-radius: 12px;
			border: none;
			padding: 15px 20px;
			margin-bottom: 25px;
		}

		.alert-danger {
			background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
			color: white;
		}

		.alert-success {
			background: linear-gradient(135deg, #51cf66 0%, #40c057 100%);
			color: white;
		}

		.form-label {
			font-weight: 600;
			color: #333;
			margin-bottom: 8px;
		}

		.card-title {
			font-size: 2rem;
			font-weight: 700;
			color: #333;
			margin-bottom: 10px;
		}

		.card-subtitle {
			color: #666;
			font-size: 1rem;
			margin-bottom: 30px;
			line-height: 1.5;
		}

		.email-display {
			background: linear-gradient(135deg, #e8f5e8 0%, #c8e6c9 100%);
			padding: 15px;
			border-radius: 12px;
			margin-bottom: 25px;
			text-align: center;
		}

			.email-display strong {
				color: #2e7d32;
				font-size: 1.1rem;
			}

		.password-strength {
			margin-top: 8px;
			font-size: 0.875rem;
		}

		.strength-indicator {
			height: 4px;
			border-radius: 2px;
			background: #e9ecef;
			margin-top: 5px;
			overflow: hidden;
		}

		.strength-bar {
			height: 100%;
			transition: all 0.3s ease;
			border-radius: 2px;
		}

		.strength-weak .strength-bar {
			background: #dc3545;
			width: 25%;
		}

		.strength-fair .strength-bar {
			background: #fd7e14;
			width: 50%;
		}

		.strength-good .strength-bar {
			background: #ffc107;
			width: 75%;
		}

		.strength-strong .strength-bar {
			background: #28a745;
			width: 100%;
		}

		.password-requirements {
			background: #f8f9fa;
			border-radius: 8px;
			padding: 15px;
			margin-top: 15px;
			font-size: 0.875rem;
		}

		.requirement {
			display: flex;
			align-items: center;
			margin: 5px 0;
			color: #6c757d;
		}

			.requirement.met {
				color: #28a745;
			}

			.requirement i {
				margin-left: 8px;
				width: 16px;
			}
	</style>
}


<div class="password-container">
	<div class="password-card">
		<div class="password-icon">
			<i class="fas fa-lock"></i>
		</div>

		<div class="text-center mb-4">
			<h2 class="card-title">كلمة المرور الجديدة</h2>
			<p class="card-subtitle">
				اختر كلمة مرور قوية وآمنة لحسابك
			</p>
		</div>

		<div class="email-display">
			<i class="fas fa-user me-2"></i>
			الحساب: <strong>@ViewBag.Email</strong>
		</div>

		@if (TempData["PasswordError"] != null)
		{
			<div class="alert alert-danger">
				<i class="fas fa-exclamation-triangle me-2"></i>
				@TempData["PasswordError"]
			</div>
		}

		@if (TempData["PasswordSuccess"] != null)
		{
			<div class="alert alert-success">
				<i class="fas fa-check-circle me-2"></i>
				@TempData["PasswordSuccess"]
			</div>
		}

		<form method="post" action="@Url.Action("UpdatePassword")" id="passwordForm">
			<div class="mb-4">
				<label for="newPassword" class="form-label">
					<i class="fas fa-key me-2"></i>
					كلمة المرور الجديدة
				</label>
				<div class="password-input-group">
					<input type="password"
						   class="form-control"
						   id="newPassword"
						   name="newPassword"
						   placeholder="أدخل كلمة المرور الجديدة"
						   required
						   minlength="6">
					<button type="button" class="password-toggle" onclick="togglePassword('newPassword')">
						<i class="fas fa-eye" id="newPasswordIcon"></i>
					</button>
				</div>
				<div class="password-strength" id="passwordStrength" style="display: none;">
					<div class="d-flex justify-content-between align-items-center">
						<span id="strengthText">قوة كلمة المرور</span>
					</div>
					<div class="strength-indicator">
						<div class="strength-bar" id="strengthBar"></div>
					</div>
				</div>
			</div>

			<div class="mb-4">
				<label for="confirmPassword" class="form-label">
					<i class="fas fa-check-double me-2"></i>
					تأكيد كلمة المرور
				</label>
			</div>
		</form>
