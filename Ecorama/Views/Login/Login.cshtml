@model Ecorama.Models.LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Style {
    <link href="~/css/login.css" rel="stylesheet" />
}

<div class="main-wrapper">
    <div class="container">
        <div class="image-side">
            <div class="image-container"></div>
        </div>
        <div class="form-side">
            <div class="logo">
                <h1>إيكوراما</h1>
            </div>
            <h2>تسجيل الدخول</h2>

            <div asp-validation-summary="All" class="validation-summary-errors"></div>

            <form asp-action="Login" asp-controller="Login" method="post">
                <div class="form-group">
                    <label asp-for="Email">البريد الإلكتروني</label>
                    <input asp-for="Email" placeholder="أدخل البريد الإلكتروني" required>
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">كلمة المرور</label>
                    <input asp-for="Password" type="password" placeholder="أدخل كلمة المرور" required>
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <div class="remember-me">
                    <input asp-for="RememberMe" type="checkbox">
                    <label asp-for="RememberMe">تذكرني</label>
                </div>

                <button type="submit" class="submit-btn">تسجيل الدخول</button>

                <div class="forgot-password">
                    <a asp-action="ForgotPassword" asp-controller="Login">هل نسيت كلمة المرور؟</a>
                </div>

                <div class="register-link">
                    ليس لديك حساب؟ <a asp-action="Register" asp-controller="Login">إنشاء حساب جديد</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}